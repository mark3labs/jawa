package orchestrator

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/copybutton"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/marker"
	"github.com/axadrn/shadcn-templ/v2/components/messagescroller"
	"github.com/axadrn/shadcn-templ/v2/components/spinner"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
	"github.com/axadrn/shadcn-templ/v2/components/toggle"
)

func detailAction(d runDetail, action string) string {
	return d.Record.basePath() + "/" + action + "?tab=" + d.Tab
}
func detailVariant(active bool) button.Variant {
	if active {
		return button.VariantDefault
	}
	return button.VariantOutline
}
func toolClass(t *runTool) string {
	if r := t.result(); r != nil && r.Error {
		return "run-tool run-tool-error"
	} else if r != nil && r.Stderr {
		return "run-tool run-tool-warning"
	}
	return "run-tool"
}

const traceMatch = "$traceFilter === '' || el.textContent.toLowerCase().includes($traceFilter.toLowerCase())"

templ runDetailPage(d runDetail, csrf string) {
	<div class={ "view run-detail-view run-detail-" + d.Tab }>
		@button.Button(button.Props{Type: button.TypeButton, Href: "/runs", Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "link"}}) {
			Back to Runs
		}
		<header class="run-detail-header">
			<h1>
				{ d.Record.Mode } run #{ strconv.Itoa(d.Record.Number) }
			</h1>
			<dl class="run-detail-metadata">
				if d.Record.AgentID != "" {
					<div>
						<dt>Agent</dt>
						<dd>
							{ d.Record.AgentID }
						</dd>
					</div>
				}
				if d.Record.RunID != "" {
					<div>
						<dt>Run</dt>
						<dd>
							{ d.Record.RunID }
						</dd>
					</div>
				}
				if d.Record.Mode != "Planning" && d.Record.Build.Branch != "" {
					<div>
						<dt>Branch</dt>
						<dd>
							{ d.Record.Build.Branch }
						</dd>
					</div>
				}
			</dl>
		</header>
		<nav class="run-detail-tabs" aria-label="Run detail tabs">
			@button.Button(button.Props{Type: button.TypeButton, Href: d.Record.path("chat"), Variant: detailVariant(d.Tab == "chat"), Attributes: templ.Attributes{"role": "link", "aria-current": isCurrent(d.Tab == "chat")}}) {
				Chat
			}
			@button.Button(button.Props{Type: button.TypeButton, Href: d.Record.path("trace"), Variant: detailVariant(d.Tab == "trace"), Attributes: templ.Attributes{"role": "link", "aria-current": isCurrent(d.Tab == "trace")}}) {
				Trace
			}
		</nav>
		if d.Tab == "trace" {
			<div class="run-trace-search" data-signals="{traceSnapshot: true, traceDurable: true, traceLive: true}">
				@label.Label(label.Props{For: "trace-filter"}) {
					Filter activity
				}
				@input.Input(input.Props{ID: "trace-filter", Type: "search", Placeholder: "Search all sources and collapsed payloads", Attributes: templ.Attributes{"data-bind:trace-filter": ""}})
				<div class="run-trace-sources" role="group" aria-label="Sources">
					@toggle.Toggle(toggle.Props{ID: "trace-source-snapshot", Variant: toggle.VariantOutline, DefaultPressed: true, Attributes: templ.Attributes{"data-on:toggle-change": "$traceSnapshot = evt.detail.pressed"}}) {
						Snapshot
					}
					@toggle.Toggle(toggle.Props{ID: "trace-source-durable", Variant: toggle.VariantOutline, DefaultPressed: true, Attributes: templ.Attributes{"data-on:toggle-change": "$traceDurable = evt.detail.pressed"}}) {
						Durable
					}
					@toggle.Toggle(toggle.Props{ID: "trace-source-live", Variant: toggle.VariantOutline, DefaultPressed: true, Attributes: templ.Attributes{"data-on:toggle-change": "$traceLive = evt.detail.pressed"}}) {
						Live
					}
				</div>
			</div>
		}
		@runDetailContent(d)
		if d.Tab == "chat" {
			@card.Card(card.Props{ID: "run-composer-surface", Class: "run-composer-surface", Attributes: templ.Attributes{"data-signals:_can-send": strconv.FormatBool(d.Policy.Send), "data-signals:_message-id": "'" + d.MessageID + "'", "data-signals:_interaction": "'" + d.Interaction + "'"}}) {
				<form id="run-composer" method="post" action={ detailAction(d, "chat") } data-indicator:run-sending data-on:submit__prevent={ "!$runSending && ($_retryText !== null && $_retryText !== $runDraft && ($_messageId = crypto.randomUUID()), $_retryText = $runDraft, @post('" + detailAction(d, "chat") + "', {contentType:'form', retry:'never'}))" }>
					<input type="hidden" name="message_id" id="run-message-id" value={ d.MessageID } data-bind:_message-id/>
					<input type="hidden" name="interaction" id="run-interaction" value={ d.Interaction } data-bind:_interaction/>
					<input type="hidden" name="_csrf" value={ csrf }/>
					@label.Label(label.Props{For: "run-draft", Class: "sr-only"}) {
						Message / follow-up
					}
					@textarea.Textarea(textarea.Props{ID: "run-draft", Name: "text", Rows: 1, Placeholder: "Message the agent", Attributes: templ.Attributes{"data-bind:run-draft": "", "maxlength": "64000", "required": true, "data-on:keydown": "evt.key === 'Enter' && evt.ctrlKey && !evt.isComposing && (evt.preventDefault(), $_canSend && !$runSending && el.form.requestSubmit())"}})
				</form>
				@runDetailControls(d, csrf)
			}
		} else {
			@runDetailControls(d, csrf)
		}
		<div hidden data-effect="$runAcceptedMessage !== '' && ($runDraft === $runConfirmedDraft && ($runDraft = ''), $_messageId = crypto.randomUUID(), $_retryText = null, $runAcceptedMessage = '', $runConfirmedDraft = '')"></div>
	</div>
}

templ planningChatComposer(chat planningChatDetail, csrf string) {
	<p class="meta">Send a message to continue this run with its saved context. Messages remain queued while the agent is unavailable.</p>
	<form data-ignore-morph id={ "planning-run-chat-" + chat.Record.ID } method="post" action={ chat.Record.basePath() + "/chat" } data-signals:planning-run-message-id={ "'" + chat.MessageID + "'" } data-indicator:run-sending data-on:submit__prevent={ "!$runSending && ($_retryText !== null && $_retryText !== $planningRunDraft && ($planningRunMessageId = crypto.randomUUID()), $_retryText = $planningRunDraft, @post('" + chat.Record.basePath() + "/chat', {contentType:'form', retry:'never'}))" }>
		<input type="hidden" name="_csrf" value={ csrf }/>
		<input type="hidden" name="message_id" value={ chat.MessageID } data-bind:planning-run-message-id/>
		<input type="hidden" name="interaction" value=""/>
		@label.Label(label.Props{For: "planning-run-draft", Class: "sr-only"}) {
			Message the planner
		}
		@textarea.Textarea(textarea.Props{ID: "planning-run-draft", Name: "text", Rows: 1, Placeholder: "Message the planning run", Attributes: templ.Attributes{"data-bind:planning-run-draft": "", "maxlength": "64000", "required": true, "data-on:keydown": "evt.key === 'Enter' && evt.ctrlKey && !evt.isComposing && (evt.preventDefault(), el.form.requestSubmit())"}})
		@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit, Attributes: templ.Attributes{"data-attr:disabled": "$runSending"}}) {
			Send message
		}
	</form>
	<div hidden data-effect="$runAcceptedMessage !== '' && ($planningRunDraft === $runConfirmedDraft && ($planningRunDraft = ''), $planningRunMessageId = crypto.randomUUID(), $_retryText = null, $runAcceptedMessage = '', $runConfirmedDraft = '')"></div>
}

templ runDetailControls(d runDetail, csrf string) {
	<div id="run-detail-controls" class="run-controls" data-interaction={ d.Interaction } data-effect={ "!$runDraft && ($_interaction = '" + d.Interaction + "')" }>
		if d.Tab == "chat" {
			<span class="meta">Ctrl+Enter to send · Messages persist before delivery</span>
			@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit, Form: "run-composer", Disabled: !d.Policy.Send, Attributes: templ.Attributes{"data-attr:disabled": "!$_canSend || $runSending"}}) {
				if d.Policy.Mode == "queue" {
					Send follow-up
				} else {
					Send message
				}
			}
		}
		if d.Policy.Stop {
			<form method="post" action={ detailAction(d, "stop") } data-on:submit={ "@post('" + detailAction(d, "stop") + "', {contentType:'form', retry:'never'})" }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<input type="hidden" name="turn_id" value={ d.Policy.Turn }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
					Stop current turn
				}
			</form>
		}
		@button.Button(button.Props{Type: button.TypeButton, Href: string(planningPath(d.Record.CardID)), Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "link"}}) {
			Open card for recovery / guidance
		}
	</div>
}

// Adapted from BONNIE web/views.templ (MIT); see BONNIE-LICENSE.
templ runDetailContent(d runDetail) {
	<div id="run-detail-content" class="run-history">
		@runDetailStatus(d)
		if d.Tab == "trace" {
			@runTrace(d)
		} else {
			@runChat(d)
		}
	</div>
}

templ runDetailStatus(d runDetail) {
	<div id="run-detail-status" class="run-detail-status">
		if d.Record.Mode == "Planning" {
			@badge.Badge() {
				{ d.Record.label() }
			}
		}
		if d.Observation.Snapshot != nil {
			<div class="meta">Observed conversation: { string(d.Observation.Snapshot.State) }</div>
		}
		if d.Record.RunState != "" {
			<div class="run-observed-state">
				@badge.Badge() {
					{ d.Record.RunState }
				}
			</div>
		}
	</div>
}

templ runPayload(text string) {
	<pre class="result"><code>@templ.Raw(newRunSection("", text).HTML)</code></pre>
}

// Sections copy from their code element, so no payload is duplicated. Long
// output scrolls inside a shadcn ScrollArea instead of the transcript.
templ runSectionView(id string, section runSection) {
	<div id={ id } class="run-tool-section">
		<div class="run-section-head">
			<span>{ section.Label }</span>
			@copybutton.CopyButton(copybutton.Props{ID: id + "-copy", TargetID: id + "-code", Class: "run-copy", Attrs: templ.Attributes{"aria-label": "Copy " + section.Label}})
		</div>
		@runScrollArea(id, "run-scroll") {
			<pre class={ "result", templ.KV("run-diff", section.Diff) }><code id={ id + "-code" }>@templ.Raw(section.HTML)</code></pre>
		}
	</div>
}

// A call and its paired result share one Trace row.
templ runToolView(key string, t *runTool, working bool) {
	{{ result := t.result() }}
	@traceCollapsible(key, toolClass(t), toolStep(t, working), false) {
		if t.Kind == "call" {
			for i, section := range t.Sections {
				@runSectionView(key+"-section-"+strconv.Itoa(i), section)
			}
		}
		if result != nil {
			for i, section := range result.Sections {
				@runSectionView(key+"-result-"+strconv.Itoa(i), section)
			}
		}
	}
}

templ runStepPart(part runPart, working bool) {
	if part.Tool != nil {
		@runToolView(part.Key, part.Tool, working)
	} else if part.Reasoning {
		@traceCollapsible(part.Key, "run-reasoning", reasoningStep, false) {
			<div class="planning-markdown run-reasoning-text">
				@templ.Raw(part.HTML)
			</div>
		}
	} else {
		@traceStatic(part.Key, attachmentStep(part.Attachment))
	}
}

// Steps (tools, thinking, attachments) render as Trace rows; the reply as prose.
templ runParts(m runMessage, working bool) {
	for _, block := range m.blocks() {
		if block[0].step() {
			@traceGroup() {
				for _, part := range block {
					@runStepPart(part, working)
				}
			}
		} else if block[0].Unsupported {
			<p class="meta">Unsupported content · see Trace</p>
		} else if block[0].Text != "" {
			if m.Role == "assistant" {
				<div class="planning-markdown">
					@templ.Raw(block[0].HTML)
				</div>
			} else {
				<div class="run-prose">
					{ block[0].Text }
				</div>
			}
		}
	}
}

// Each entry is its own patch unit. User messages after the first start a
// new exchange, labelled with the accepted time when a receipt places it.
// Consecutive assistant and tool messages read as one reply under one label.
templ runChatEntry(d runDetail, e runChatEntryView) {
	<div id={ e.Message.Key } class="run-chat-entry">
		if e.Boundary {
			@marker.Marker(marker.Props{Variant: marker.VariantSeparator, Class: "run-exchange"}) {
				if sent := d.sentLabel(e.Index); sent != "" {
					@marker.Content() {
						{ sent }
					}
				}
			}
		}
		<article class={ "run-chat-message run-role-" + e.Message.Role, templ.KV("run-continued", !e.ShowRole) }>
			if e.ShowRole {
				<strong class="run-message-role">
					{ runRole(e.Role) }
				</strong>
			}
			@runParts(e.Message, d.Observation.working())
		</article>
	</div>
}

templ runMessages(d runDetail) {
	<div id="run-messages" class="run-messages">
		for _, e := range d.chatEntries() {
			@runChatEntry(d, e)
		}
	</div>
}

templ runChat(d runDetail) {
	@messagescroller.Provider(messagescroller.ProviderProps{AutoScroll: true}) {
		@messagescroller.MessageScroller(messagescroller.Props{ID: "run-message-scroller", Attributes: templ.Attributes{"data-preserve-attr": "data-pending-scroll"}}) {
			@messagescroller.Viewport(messagescroller.ViewportProps{ID: "run-transcript", Class: "run-chat-transcript", Attributes: templ.Attributes{"data-preserve-attr": "data-pending-scroll"}}) {
				@messagescroller.Content(messagescroller.ContentProps{ID: "run-transcript-content"}) {
					@runMessages(d)
					@runLive(d)
					@runPending(d)
				}
			}
			@messagescroller.Button(messagescroller.ButtonProps{ID: "run-scroll-end"})
		}
	}
}

// Uncommitted activity for the current turn; the next snapshot replaces it.
templ runLive(d runDetail) {
	{{ v := liveActivity(d.Observation) }}
	<div id="run-live" class="run-live">
		if !v.empty() {
			<article class="run-chat-message run-role-assistant run-live-message">
				<strong class="run-message-role">Assistant</strong>
				for i, block := range v.blocks() {
					if block[0].Kind == "text" {
						<div class="run-prose">
							if i == 0 && v.Truncated {
								…
							}
							{ block[0].Text }
						</div>
					} else {
						@traceGroup() {
							for _, item := range block {
								if item.Kind == "reasoning" {
									@traceCollapsible(item.Key, "run-reasoning", runStep{Icon: reasoningStep.Icon, Verb: "Thinking", Status: "running"}, true) {
										<div class="run-prose run-reasoning-text">
											if i == 0 && v.Truncated {
												…
											}
											{ item.Text }
										</div>
									}
								} else {
									@traceStatic(item.Key, liveStep(item))
								}
							}
						}
					}
				}
				if v.Working {
					<div class="run-working meta">
						@spinner.Spinner(spinner.Props{Attributes: templ.Attributes{"aria-label": "Agent working"}})
						Working…
					</div>
				}
			</article>
		}
	</div>
}

// Delivery records are separate from immutable workflow status and remote
// transcript. A status row never claims an unavailable conversation recovered.
templ runPending(d runDetail) {
	<section id="run-pending" aria-label="Messages" class="run-pending">
		for _, message := range d.Chat {
			if !message.InTranscript || message.Failure != "" || message.Status == "ambiguous" {
				<article id={ "chat-delivery-" + message.ID } class="run-chat-message run-role-user run-delivery">
					<div class="run-delivery-header">
						<strong class="run-message-role">User</strong>
						@badge.Badge(badge.Props{Variant: deliveryVariant(message.Status)}) {
							{ deliveryLabel(message.Status) }
						}
					</div>
					if !message.InTranscript {
						<div class="run-prose">{ message.Text }</div>
					}
					if message.Failure != "" {
						<p class="meta">{ message.Failure }</p>
					}
					if message.Status == "ambiguous" {
						<form method="post" action={ detailAction(d, "reconcile") }>
							<input type="hidden" name="_csrf" value={ d.CSRF }/>
							<input type="hidden" name="chat_id" value={ message.ID }/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
								Reconcile uncertain message (do not replay)
							}
						</form>
					}
				</article>
			}
		}
	</section>
}

templ runTraceTableView(t runTraceTable) {
	if len(t.Rows) > 0 {
		<section id={ t.ID } class="run-trace-source" data-show={ traceGroupExpr("", "[data-trace-entry]") }>
			<h2>
				{ t.Title }
			</h2>
			@table.Table(table.Props{Class: "run-trace-table"}) {
				@table.Header() {
					@table.Row() {
						for _, column := range t.Columns {
							@table.Head() {
								{ column }
							}
						}
					}
				}
				@table.Body() {
					for i, row := range t.Rows {
						if row.Turn != "" && (i == 0 || t.Rows[i-1].Turn != row.Turn) {
							@table.Row(table.RowProps{Class: "run-turn", Attributes: templ.Attributes{"data-trace-turn-header": true, "data-show": traceGroupExpr(".closest('tbody')", "[data-trace-turn=\""+traceTurnKey(row.Turn)+"\"]")}}) {
								@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": strconv.Itoa(len(t.Columns))}}) {
									{ row.Turn }
								}
							}
						}
						@table.Row(table.RowProps{Class: traceStripe(row.Stripe), Attributes: traceRowAttrs(row)}) {
							for _, cell := range row.Cells {
								@table.Cell() {
									{ cell }
								}
							}
							@table.Cell(table.CellProps{Class: "run-summary-cell"}) {
								<details id={ row.Key } data-preserve-attr="open">
									<summary>
										{ row.Summary }
									</summary>
									@runPayload(row.Raw)
								</details>
							}
						}
					}
				}
			}
		</section>
	}
}

templ runTrace(d runDetail) {
	<div id="run-trace" class="run-trace-inspector">
		@runTraceTableView(snapshotTrace(d.Messages))
		@runTraceTableView(eventTimeline(d.Observation.Durable, d.Observation.Live))
	</div>
}
