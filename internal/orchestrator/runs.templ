package orchestrator

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
)

templ runsContent(d pageData) {
	<div id="runs-content" class="view runs-view">
		<div class="view-head">
			<div>
				<h1>Runs</h1>
				<p class="meta">Every attempt agents have made, newest first.</p>
			</div>
			if d.v.Card != "" {
				if c, ok := cardByID(d.cards, d.v.Card); ok {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip filter-chip", Href: "/runs", Attributes: templ.Attributes{"title": "Clear filter"}}) {
						<span>{ cardKey(d.projects, c) }</span>
						<span aria-hidden="true">✕</span>
					}
				}
			}
		</div>
		<nav class="tabs" aria-label="Filter runs by state">
			for _, tab := range runStateTabs {
				<a class="tab" href={ templ.SafeURL(runsPath(d.v, tab)) } aria-current={ isCurrent(d.v.State == tab) }>
					<span>{ tabLabel(tab) }</span>
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "tab-count"}) {
						{ strconv.Itoa(countRunStates(filterRuns(d.attempts, viewParams{Card: d.v.Card, State: "all"}), tab)) }
					}
				</a>
			}
		</nav>
		if rows := filterRuns(d.attempts, d.v); len(rows) > 0 {
			<div class="run-list" role="list">
				<div class="run-head" aria-hidden="true">
					<span></span>
					<span>Card</span>
					<span>State</span>
					<span>Attempt</span>
					<span>Agent</span>
					<span>PR</span>
					<span>Updated</span>
				</div>
				for _, a := range rows {
					@runRow(d, a)
				}
			</div>
		} else {
			@empty.Empty(empty.Props{Class: "page-empty"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon("runs")
					}
					@empty.Title() {
						No runs here yet
					}
					@empty.Description() {
						Move a card to Building and an agent will pick it up. Each attempt shows up here with its branch, pull request and result.
					}
				}
			}
		}
	</div>
}

templ runRow(d pageData, a Attempt) {
	<details id={ "run-" + a.ID } class={ "run", "tone-" + runTone(a) } role="listitem" data-preserve-attr="open">
		<summary class="run-row">
			@toneIcon(runTone(a))
			<span class="run-main">
				if c, ok := cardByID(d.cards, a.CardID); ok {
					<span class="run-key">{ cardKey(d.projects, c) }</span>
					<span class="run-title">{ c.Title }</span>
				} else {
					<span class="run-key">{ shortID(a.CardID) }</span>
					<span class="run-title muted">Deleted card</span>
				}
			</span>
			@badge.Badge(badge.Props{Class:"run-state tone-"+runTone(a), Variant:badge.VariantOutline}) { { d.runLabel(a) } }
			<span class="run-attempt">#{ strconv.Itoa(a.Number) }</span>
			<span class="run-agent">{ displayDash(a.AgentID) }</span>
			<span class="run-pr">
				@manualReadyBadge(d, a)
				if pr := safeActivityURL(a.PRURL); pr != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip", Href: pr, Attributes: templ.Attributes{"target": "_blank", "rel": "noopener noreferrer"}}) {
						@icon("pr")
						<span>PR</span>
					}
				} else {
					<span class="muted">—</span>
				}
			</span>
			<span class="run-time">
				<jawa-time datetime={ timeAttr(a.UpdatedAt) }>{ relativeTime(a.UpdatedAt, d.now) }</jawa-time>
			</span>
		</summary>
		<div class="run-body">
			if a.AgentID != "" && a.RunID != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip", Href: detailPath(a, "chat")}) {
					@icon("runs")<span>Open</span>
				}
			}
			<dl class="facts">
				<div>
					<dt>Branch</dt>
					<dd class="mono">
						@icon("branch")
						<span>{ attemptBranch(a) }</span>
						<jawa-copy text={ attemptBranch(a) } aria-label="Copy branch name">
							@button.Button(button.Props{Type: button.TypeButton, Class: "icon-btn", Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"aria-label": "Copy branch name"}}) {
								@icon("copy")
							}
						</jawa-copy>
					</dd>
				</div>
				<div>
					<dt>Run state</dt>
					<dd>{ displayDash(a.RunState) }</dd>
				</div>
				<div>
					<dt>Run ID</dt>
					<dd class="mono">{ displayDash(a.RunID) }</dd>
				</div>
				<div>
					<dt>Task ID</dt>
					<dd class="mono">{ a.TaskID }</dd>
				</div>
				<div>
					<dt>Created</dt>
					<dd>{ a.CreatedAt.UTC().Format("2006-01-02 15:04:05 UTC") }</dd>
				</div>
			</dl>
			if a.Error != "" {
				@alert.Alert(alert.Props{Class: "card-note tone-" + runTone(a)}) {
					{ a.Error }
				}
			}
			if a.Result != "" {
				<h4 class="body-label">Agent result</h4>
				<pre class="result">{ a.Result }</pre>
			}
		</div>
	</details>
}
