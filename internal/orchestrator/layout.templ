package orchestrator

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/breadcrumb"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/kbd"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/nativeselect"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
	"net/http"
)

func authPageWithRequest(w http.ResponseWriter, r *http.Request, kind, msg string) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	_ = auth(CSRFToken(r), kind, msg).Render(r.Context(), w)
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
		<meta name="color-scheme" content="dark"/>
		<meta name="theme-color" content="#130f0b"/>
		<meta name="description" content="Jawa — your coding agent workspace. Plan tasks, follow builds, and manage agents."/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-title" content="Jawa"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
		<link rel="manifest" href="/assets/manifest.webmanifest"/>
		<link rel="apple-touch-icon" href="/assets/icon-180.png"/>
		<title>{ title }</title>
		<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
		<link rel="preload" href="/assets/inter.woff2" as="font" type="font/woff2" crossorigin/>
		// Keep this first-paint fallback aligned with frontend/src/style.css.
		// Full styling and contextual icon sizes remain in the external stylesheet.
		<style>
			html, body { background: #130f0b; color: #eee2cf; }
			body { margin: 0; font: 13px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
			.ic { width: 16px; height: 16px; flex: none; }
			.lane-ic, .tone-ic { width: 15px; height: 15px; flex: none; }
		</style>
		<link rel="stylesheet" href={ templ.SafeURL(assetURL("style.css")) }/>
		<script type="module" src={ templ.SafeURL(assetURL("app.js")) }></script>
	</head>
}

// logo is the Jawa mark: a hooded figure whose two eyes glow amber.
templ logo(size int) {
	<svg class="logo" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 32 32" aria-hidden="true">
		<path d="M16 2.5c-6.4 0-10.5 5-10.5 11.4V25c0 2.2 1.6 4.2 4.2 4.2h12.6c2.6 0 4.2-2 4.2-4.2V13.9C26.5 7.5 22.4 2.5 16 2.5z" fill="#3b2d1d" stroke="#6b5036" stroke-width="1"></path>
		<path d="M9.2 15.2c0-3.2 2.9-5.4 6.8-5.4s6.8 2.2 6.8 5.4v2.2c0 2.6-2.9 4.6-6.8 4.6s-6.8-2-6.8-4.6z" fill="#0d0a07"></path>
		<circle cx="12.6" cy="15.6" r="3" fill="#ffb000" opacity=".18"></circle>
		<circle cx="19.4" cy="15.6" r="3" fill="#ffb000" opacity=".18"></circle>
		<circle cx="12.6" cy="15.6" r="1.35" fill="#ffc533"></circle>
		<circle cx="19.4" cy="15.6" r="1.35" fill="#ffc533"></circle>
	</svg>
}

templ icon(name string) {
	<svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "archive":
				<rect x="3" y="4" width="18" height="4" rx="1"></rect>
				<path d="M5 8v12h14V8M10 12h4"></path>
			case "eye":
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "board":
				<rect x="3" y="3" width="7" height="18" rx="1.5"></rect>
				<rect x="14" y="3" width="7" height="11" rx="1.5"></rect>
			case "runs":
				<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
			case "agents":
				<rect x="4" y="8" width="16" height="12" rx="3"></rect>
				<path d="M12 8V5"></path>
				<circle cx="12" cy="3.7" r="1.2"></circle>
				<circle cx="9" cy="14" r="1.1" fill="currentColor"></circle>
				<circle cx="15" cy="14" r="1.1" fill="currentColor"></circle>
			case "settings":
				<path d="M4 7h9M17 7h3M4 17h3M11 17h9"></path>
				<circle cx="15" cy="7" r="2"></circle>
				<circle cx="9" cy="17" r="2"></circle>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "more":
				<circle cx="5.5" cy="12" r="1.2" fill="currentColor"></circle>
				<circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
				<circle cx="18.5" cy="12" r="1.2" fill="currentColor"></circle>
			case "search":
				<circle cx="11" cy="11" r="6.5"></circle>
				<path d="m20 20-4-4"></path>
			case "branch":
				<circle cx="6" cy="5.5" r="2"></circle>
				<circle cx="6" cy="18.5" r="2"></circle>
				<circle cx="18" cy="9" r="2"></circle>
				<path d="M6 7.5v9M18 11c0 4-12 2-12 6"></path>
			case "pr":
				<circle cx="6" cy="5.5" r="2"></circle>
				<circle cx="6" cy="18.5" r="2"></circle>
				<circle cx="18" cy="18.5" r="2"></circle>
				<path d="M6 7.5v9M18 16.5V10a3 3 0 0 0-3-3h-3m2-2.5-2 2.5 2 2.5"></path>
			case "issue":
				<circle cx="12" cy="12" r="8.5"></circle>
				<circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
			case "external":
				<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
			case "copy":
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
			case "warning":
				<path d="M12 3 2 21h20L12 3z"></path>
				<path d="M12 9v5M12 17v.1"></path>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7"></path>
			case "trash":
				<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path>
			case "reset":
				<path d="M4 9h10a5 5 0 0 1 0 10H8M4 9l4-4M4 9l4 4"></path>
			case "play":
				<path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
			case "retry":
				<path d="M20 11a8 8 0 1 0-2.3 6M20 4v7h-7"></path>
			case "logout":
				<path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M15 8l4 4-4 4M19 12H9"></path>
			case "key":
				<circle cx="8" cy="15" r="4"></circle>
				<path d="m11 12 8-8M16 7l3 3"></path>
			case "server":
				<rect x="3" y="4" width="18" height="7" rx="2"></rect>
				<rect x="3" y="13" width="18" height="7" rx="2"></rect>
				<path d="M7 7.5h.01M7 16.5h.01"></path>
		}
	</svg>
}

// laneIcon is the Linear-style status glyph shown on board columns.
templ laneIcon(status string) {
	<svg class={ "ic lane-ic lane-" + status } width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		switch status {
			case "Todo":
				<circle cx="12" cy="12" r="8" stroke-dasharray="3.2 3.2"></circle>
			case "Planning":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M9 9h6M9 12h6M9 15h3"></path>
			case "Fix":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M8 9a5 5 0 1 1-1 5M8 6v4H4"></path>
			case "Building":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M12 7a5 5 0 0 1 0 10z" fill="currentColor" stroke="none"></path>
			default:
				<circle cx="12" cy="12" r="8.5" fill="currentColor" stroke="none"></circle>
				<path d="m8.4 12.3 2.5 2.5 4.8-5.2" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
		}
	</svg>
}

// toneIcon is the glyph for an attempt's state.
templ toneIcon(tone string) {
	<svg class={ "ic tone-ic tone-" + tone } width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch tone {
			case "running":
				<circle cx="12" cy="12" r="8"></circle>
				<path class="spin" d="M12 4a8 8 0 0 1 8 8" stroke-width="3"></path>
			case "blocked":
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M12 7.5v5M12 15.8h.01"></path>
			case "failed":
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="m9 9 6 6M15 9l-6 6"></path>
			case "ready":
				<circle cx="12" cy="12" r="8.5" fill="currentColor" stroke="none"></circle>
				<path d="m8.4 12.3 2.5 2.5 4.8-5.2" stroke="var(--bg)"></path>
			default:
				<circle cx="12" cy="12" r="8" stroke-dasharray="1.5 3.4"></circle>
		}
	</svg>
}

templ submit(title string) {
	@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeSubmit, Class: "btn primary"}) {
		{ title }
	}
}

templ textField(id, name, title, value string, required bool) {
	<div class="field">
		@label.Label(label.Props{For: id}) {
			{ title }
		}
		@input.Input(input.Props{ID: id, Name: name, Value: value, Required: required})
	</div>
}

// viewFields keeps mutations aware of the screen they came from, so the
// response patches the right roots.
templ viewFields(v viewParams) {
	<input type="hidden" name="view" value={ string(v.View) }/>
	<input type="hidden" name="project" value={ v.Project }/>
	<input type="hidden" name="card" value={ v.Card }/>
	<input type="hidden" name="state" value={ v.State }/>
}

func viewLabel(v viewKind) string {
	switch v {
	case viewArchive:
		return "Archive"
	case viewPlanning:
		return "Planning"
	case viewRuns:
		return "Runs"
	case viewAgents:
		return "Agents"
	case viewSettings:
		return "Settings"
	}
	return "Board"
}

func pageTitle(d pageData) string {
	if d.v.View == viewBoard {
		if p, ok := projectByID(d.projects, d.v.Project); ok {
			return p.Name + " · Jawa"
		}
	}
	return viewLabel(d.v.View) + " · Jawa"
}

func shellSignals() string {
	return "{runDraft:'',traceFilter:'',filter:'',projectOpen:false,projectProvider:'github',cardOpen:false,deleteOpen:false,deleteCard:'',deleteOrphan:false,deleteAcknowledged:false,cancelOpen:false,cancelCard:'',forceOpen:false,forceCard:'',forceAcknowledged:false,readyOpen:false,readyCard:'',readyToken:'',readyPR:'',readyNumber:'',readyReason:'',readyAcknowledged:false,readyLane:'',fixOpen:false,fixCard:'',fixMessage:'',guideOpen:false,guideCard:'',guideToken:'',guideMessage:'',goto:''}"
}

func isCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ appPage(d pageData) {
	<!DOCTYPE html>
	<html lang="en">
		@head(pageTitle(d))
		<body class="style-nova app">
			<div
				class="shell"
				data-signals={ shellSignals() }
				data-init={ "@get('" + pageEventsURL(d) + "')" }
				data-effect="if ($goto.startsWith('/')) window.location.assign($goto)"
				data-on:board-refresh={ d.v.SnapshotAction() }
			>
				@sidebar(d)
				<div class="main">
					@topbar(d)
					<main class="content" id="content">
						@notification("", "")
						switch d.v.View {
							case viewArchive:
								@archiveContent(d)
							case viewPlanning:
								@planningContent(d)
							case viewRuns:
								if d.detail != nil {
									@runDetailPage(*d.detail, d.csrf)
								} else {
									@runsContent(d)
								}
							case viewAgents:
								@agentsContent(d)
							case viewSettings:
								@settingsContent(d)
							default:
								@boardContent(d)
						}
					</main>
				</div>
				@dialogs(d)
				<jawa-shortcuts></jawa-shortcuts>
			</div>
		</body>
	</html>
}

templ sidebar(d pageData) {
	<aside class="sidebar">
		<a class="brand" href="/board">
			@logo(26)
			<span class="brand-name">Jawa</span>
			<span class="brand-tag">Orchestrator</span>
		</a>
		@sidebarNav(d)
		<div class="sidebar-foot">
			<div class="hints" aria-label="Keyboard shortcuts">
				<span>@kbd.Kbd() {
	C
}</span><span>new card</span>
				<span>@kbd.Kbd() {
	/
}</span><span>filter</span>
				<span>@kbd.Kbd() {
	G
}@kbd.Kbd() {
	B
}</span><span>go to…</span>
			</div>
			<form method="post" action="/logout">
				<input type="hidden" name="_csrf" value={ d.csrf }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "nav-item nav-quiet", Size: button.SizeSm, Variant: button.VariantGhost}) {
					@icon("logout")
					<span>Sign out</span>
				}
			</form>
		</div>
	</aside>
}

// sidebarNav is a live patch root: counts follow the work in progress.
templ sidebarNav(d pageData) {
	<nav id="sidebar-nav" class="nav" aria-label="Primary">
		<div class="nav-group">
			<div class="nav-label">Workspace</div>
			<a class="nav-item" href="/archive" aria-current={ isCurrent(d.v.View == viewArchive) }>
				@icon("archive")
				<span>Archive</span>
			</a>
			<a class="nav-item" href="/runs" aria-current={ isCurrent(d.v.View == viewRuns) }>
				@icon("runs")
				<span>Runs</span>
				if n := countRunStates(d.attempts, "active"); n > 0 {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "nav-count live"}) {
						{ strconv.Itoa(n) }
					}
				}
			</a>
			<a class="nav-item" href="/agents" aria-current={ isCurrent(d.v.View == viewAgents) }>
				@icon("agents")
				<span>Agents</span>
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: templ.Classes("nav-count", templ.KV("online", readyAgents(d.agents) > 0)).String()}) {
					{ strconv.Itoa(readyAgents(d.agents)) }
				}
			</a>
			<a class="nav-item" href="/settings" aria-current={ isCurrent(d.v.View == viewSettings) }>
				@icon("settings")
				<span>Settings</span>
			</a>
		</div>
		<div class="nav-group">
			<div class="nav-label nav-label-row">
				<span>Projects</span>
				@button.Button(button.Props{Type: button.TypeButton, Class: "icon-btn", Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"aria-label": "New project", "data-on:click": "$projectOpen = true"}}) {
					@icon("plus")
				}
			</div>
			for _, p := range d.projects {
				{{ work := projectWork(d.uiSnapshot, p.ID) }}
				<a aria-label={ p.Name + ": " + work.Label() } class="nav-item" href={ templ.SafeURL(boardPath(p.ID)) } aria-current={ isCurrent(d.v.View == viewBoard && d.v.Project == p.ID) } data-project-id={ p.ID } data-project-name={ p.Name }>
					<span class="proj-mark">{ initial(p.Name) }</span>
					<span class="nav-text">{ p.Name }</span>
					if work.Total() > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "nav-count live", Attributes: templ.Attributes{"title": work.Label()}}) {
							{ strconv.Itoa(work.Total()) }
						}
					}
				</a>
			}
			if len(d.projects) == 0 {
				<p class="nav-empty">No projects yet.</p>
			}
		</div>
	</nav>
}

templ topbar(d pageData) {
	<header class="topbar">
		@breadcrumb.Breadcrumb() {
			@breadcrumb.List() {
				@breadcrumb.Item() {
					@breadcrumb.Link(breadcrumb.LinkProps{Href: "/board"}) {
						Workspace
					}
				}
				@breadcrumb.Separator()
				@breadcrumb.Item() {
					if _, ok := projectByID(d.projects, d.v.Project); ok && d.v.View == viewBoard {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "/board"}) {
							Board
						}
					} else {
						@breadcrumb.Page() {
							{ viewLabel(d.v.View) }
						}
					}
				}
				if d.v.View == viewBoard {
					if p, ok := projectByID(d.projects, d.v.Project); ok {
						@breadcrumb.Separator()
						@breadcrumb.Item() {
							@breadcrumb.Page() {
								{ p.Name }
							}
						}
					}
				}
			}
		}
		<div class="topbar-actions">
			if d.v.View == viewBoard || d.v.View == viewArchive {
				@label.Label(label.Props{Class: "search"}) {
					@icon("search")
					@input.Input(input.Props{ID: "card-filter", Class: "filter", Placeholder: "Filter cards", Attributes: templ.Attributes{"aria-label": "Filter cards", "data-bind:filter": "", "autocomplete": "off"}})
					@kbd.Kbd() {
						/
					}
				}
			}
			@agentStatus(d)
			if len(d.projects) > 0 {
				@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeButton, Class: "btn primary", Attributes: templ.Attributes{"data-on:click": "$cardOpen = true"}}) {
					@icon("plus")
					New card
				}
			}
		</div>
	</header>
}

// agentStatus is a live patch root present on every screen.
templ agentStatus(d pageData) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, ID: "agent-status", Class: templ.Classes("agent-chip", templ.KV("online", readyAgents(d.agents) > 0), templ.KV("degraded", !d.presence)).String(), Href: "/agents", Attributes: templ.Attributes{"title": "Open agents"}}) {
		<span class="pulse-dot"></span>
		if !d.presence {
			<span>Presence unavailable</span>
		} else if n := readyAgents(d.agents); n == 0 {
			<span>No agents online</span>
		} else if n == 1 {
			<span>1 agent online</span>
		} else {
			<span>{ strconv.Itoa(n) } agents online</span>
		}
	}
}

// notification is an independent patch root; errors never discard a draft.
templ notification(message, tone string) {
	@alert.Alert(alert.Props{ID: "notice", Class: "notice " + tone, Attributes: templ.Attributes{"role": "alert", "aria-live": "polite", "hidden": message == ""}}) {
		{ message }
	}
}

templ dialogs(d pageData) {
	<dialog id="fix-dialog" aria-labelledby="fix-dialog-title" data-effect="if ($fixOpen && !el.open) el.showModal(); else if (!$fixOpen && el.open) el.close()" data-on:close="$fixOpen = false" data-on:cancel="$fixOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "fix-dialog-title"}) {
			Send to Fix
		}
		@dialog.Description() {
			Describe what needs fixing. An agent will update the existing pull request on its original branch, without merging it.
		}
		<form method="post" action="/cards/fix" data-on:submit__prevent="@post('/cards/fix', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:fix-card/>
			<div class="field">
				@label.Label(label.Props{For: "fix-message"}) {
					Fix message (required)
				}
				@textarea.Textarea(textarea.Props{ID: "fix-message", Name: "message", Rows: 5, Attributes: templ.Attributes{"required": true, "data-bind:fix-message": true, "autofocus": true}})
			</div>
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$fixOpen = false"}}) {
					Keep in Ready for review
				}
				@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeSubmit, Class: "btn primary", Attributes: templ.Attributes{"data-attr:disabled": "!$fixMessage.trim()"}}) {
					Send to Fix
				}
			}
		</form>
	</dialog>
	<dialog id="guide-dialog" aria-labelledby="guide-dialog-title" data-effect="if ($guideOpen && !el.open) el.showModal(); else if (!$guideOpen && el.open) el.close()" data-on:close="$guideOpen = false" data-on:cancel="$guideOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "guide-dialog-title"}) {
			Reply with guidance
		}
		@dialog.Description() {
			The agent paused on a blocker. Your guidance resumes the same run, keeping its conversation, branch and work so far.
		}
		<form method="post" action="/cards/guide" data-on:submit__prevent="@post('/cards/guide', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:guide-card/>
			<input type="hidden" name="expected_interaction" data-bind:guide-token/>
			<div class="field">
				@label.Label(label.Props{For: "guide-message"}) {
					Guidance (required)
				}
				@textarea.Textarea(textarea.Props{ID: "guide-message", Name: "message", Rows: 5, Attributes: templ.Attributes{"required": true, "maxlength": "64000", "data-bind:guide-message": true, "autofocus": true}})
			</div>
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$guideOpen = false"}}) {
					Not now
				}
				@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeSubmit, Class: "btn primary", Attributes: templ.Attributes{"data-attr:disabled": "!$guideMessage.trim()"}}) {
					Send guidance
				}
			}
		</form>
	</dialog>
	<dialog id="project-dialog" aria-labelledby="project-dialog-title" data-effect="if ($projectOpen && !el.open) el.showModal(); else if (!$projectOpen && el.open) el.close()" data-on:close="$projectOpen = false" data-on:cancel="$projectOpen = false">
		<form method="post" action="/projects" data-on:submit__prevent="@post('/projects', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			@dialog.Title(dialog.TitleProps{ID: "project-dialog-title"}) {
				New project
			}
			<p class="muted">Connect a repository so agents can open pull requests against it.</p>
			@textField("project-name", "name", "Name", "", true)
			<div class="field">
				@label.Label(label.Props{For: "project-provider"}) {
					Provider
				}
				@nativeselect.NativeSelect(nativeselect.Props{ID: "project-provider", Name: "provider", Attributes: templ.Attributes{"data-bind:project-provider": true}}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: "github"}) {
						GitHub
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "forgejo"}) {
						Forgejo
					}
				}
			</div>
			<div class="field" hidden data-attr:hidden="$projectProvider !== 'forgejo'">
				@label.Label(label.Props{For: "project-forgejo-url"}) {
					Forgejo URL
				}
				@input.Input(input.Props{ID: "project-forgejo-url", Name: "forgejo_url", Type: "url", Value: "https://codeberg.org", Attributes: templ.Attributes{"data-attr:required": "$projectProvider === 'forgejo'", "data-attr:disabled": "$projectProvider !== 'forgejo'"}})
			</div>
			<div class="field">
				@label.Label(label.Props{For: "project-repo"}) {
					Repository name
				}
				@input.Input(input.Props{ID: "project-repo", Name: "repo_name", Placeholder: "owner/repo", Required: true, Attributes: templ.Attributes{"pattern": "[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+", "aria-describedby": "project-repo-help"}})
				<p id="project-repo-help" class="muted">Enter owner/repo, not a full URL. GitHub uses https://github.com; Forgejo uses the URL above.</p>
			</div>
			@textField("project-base", "base_branch", "Base branch", "main", true)
			<div class="dialog-actions">
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$projectOpen = false"}}) {
					Cancel
				}
				@submit("Create project")
			</div>
		</form>
	</dialog>
	<dialog id="card-dialog" aria-labelledby="card-dialog-title" data-effect="if ($cardOpen && !el.open) el.showModal(); else if (!$cardOpen && el.open) el.close()" data-on:close="$cardOpen = false" data-on:cancel="$cardOpen = false">
		<form method="post" action="/cards" data-on:submit__prevent="if (!el.hasAttribute('data-pending')) @post('/cards', {contentType:'form', retry: 'never'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			<input id="card-issue-submission" type="hidden" name="issue_submission" value={ newID() }/>
			@viewFields(d.v)
			@dialog.Title(dialog.TitleProps{ID: "card-dialog-title"}) {
				New card
			}
			<p class="muted">Describe the outcome you want. An agent plans and ships it as a pull request.</p>
			<div class="field">
				@label.Label(label.Props{For: "card-project"}) {
					Project
				}
				@nativeselect.NativeSelect(nativeselect.Props{Name: "project_id", ID: "card-project", Required: true}) {
					for _, p := range d.projects {
						@nativeselect.Option(nativeselect.OptionProps{Value: p.ID, Selected: p.ID == d.v.Project}) {
							{ p.Name }
						}
					}
				}
			</div>
			@textField("card-title", "title", "Title", "", true)
			<div class="field">
				@label.Label(label.Props{For: "card-description"}) {
					Description
				}
				@textarea.Textarea(textarea.Props{ID: "card-description", Name: "description", Rows: 5})
			</div>
			<jawa-issue-selector class="field">
				@label.Label(label.Props{For: "card-issue"}) {
					Open issue (optional)
				}
				<div class="issue-autofill-row">
					@nativeselect.NativeSelect(nativeselect.Props{ID: "card-issue", Name: "issue_url", Attributes: templ.Attributes{"aria-describedby": "card-issue-status"}}) {
						@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
							No linked issue
						}
					}
					@label.Label(label.Props{ID: "card-create-issue-label", For: "card-create-issue", Attributes: templ.Attributes{"data-create-issue": true}}) {
						@checkbox.Checkbox(checkbox.Props{ID: "card-create-issue", Name: "create_issue", Value: "yes", DefaultChecked: true, Attributes: templ.Attributes{"aria-labelledby": "card-create-issue-label", "aria-describedby": "card-create-issue-help"}})
						Create issue
					}
					@button.Button(button.Props{Class: "btn", Type: button.TypeButton, Disabled: true, Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-issue-autofill": true, "hidden": true, "aria-label": "Autofill title and description from issue", "aria-describedby": "card-issue-autofill-help"}}) {
						Autofill
					}
				</div>
				<p id="card-create-issue-help" data-create-help class="muted">Creating the card will also create and link an issue in this project's repository.</p>
				<div id="card-issue-recovery"></div>
				<p id="card-issue-autofill-help" class="muted">Autofill replaces the title and description. You can edit them afterward.</p>
				<p id="card-issue-status" class="muted" role="status" aria-live="polite">Open the dialog to load this project's issues.</p>
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-issue-refresh": ""}}) {
					Refresh issues
				}
				<noscript>
					Issue creation occurs only on submit. Uncheck Create issue for an unlinked card. Enable JavaScript to select an open issue.
				</noscript>
			</jawa-issue-selector>
			<div class="dialog-actions">
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$cardOpen = false"}}) {
					Cancel
				}
				@submit("Create card")
			</div>
		</form>
	</dialog>
	<dialog id="delete-dialog" aria-labelledby="delete-dialog-title" data-effect="if ($deleteOpen && !el.open) el.showModal(); else if (!$deleteOpen && el.open) el.close()" data-on:close="$deleteOpen = false" data-on:cancel="$deleteOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "delete-dialog-title"}) {
			Delete this card?
		}
		@dialog.Description() {
			This permanently removes the card and its attempt history. This cannot be undone.
			<span data-show="$deleteOrphan">This run needs reconciliation. Deleting does not stop the agent: it may orphan a run that continues working, committing, or opening pull requests.</span>
		}
		<form method="post" action="/cards/delete" data-on:submit__prevent="@post('/cards/delete', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:delete-card/>
			@label.Label(label.Props{ID:"delete-acknowledge-label", For:"delete-acknowledge", Attributes: templ.Attributes{"data-show": "$deleteOrphan"}}) {
				@acknowledgement("delete-acknowledge", "acknowledge_orphan", "deleteAcknowledged", "$deleteOrphan")
				I understand that deleting may orphan a still-running agent.
			}
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$deleteOpen = false"}}) {
					Keep card
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Class: "btn danger"}) {
					Delete permanently
				}
			}
		</form>
	</dialog>
	<dialog id="cancel-dialog" aria-labelledby="cancel-dialog-title" data-effect="if ($cancelOpen && !el.open) el.showModal(); else if (!$cancelOpen && el.open) el.close()" data-on:close="$cancelOpen = false" data-on:cancel="$cancelOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "cancel-dialog-title"}) {
			Request cancellation?
		}
		@dialog.Description() {
			This asks the agent to stop its current run; cancellation may not be confirmed. It cannot undo external actions already taken, such as commits or pull requests.
		}
		<form method="post" action="/cards/cancel" data-on:submit__prevent="@post('/cards/cancel', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:cancel-card/>
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$cancelOpen = false"}}) {
					Keep running
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Class: "btn danger"}) {
					Request cancellation
				}
			}
		</form>
	</dialog>
	<dialog id="force-dialog" aria-labelledby="force-dialog-title" data-effect="if ($forceOpen && !el.open) el.showModal(); else if (!$forceOpen && el.open) el.close()" data-on:close="$forceOpen = false" data-on:cancel="$forceOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "force-dialog-title"}) {
			Force stop this run?
		}
		@dialog.Description() {
			Use this when a run is stuck or its agent is gone. JAWA stops tracking the run now and ignores anything it reports later. The agent is asked to stop, but it may keep running and could still push commits or update its pull request. Afterwards you can retry, reset to Todo, or delete the card.
		}
		<form method="post" action="/cards/force-stop" data-on:submit__prevent="@post('/cards/force-stop', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:force-card/>
			@label.Label(label.Props{ID:"force-acknowledge-label", For:"force-acknowledge"}) {
				@acknowledgement("force-acknowledge", "acknowledge", "forceAcknowledged", "true")
				I understand the agent may still be running.
			}
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$forceOpen = false"}}) {
					Keep run
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Class: "btn danger"}) {
					Force stop
				}
			}
		</form>
	</dialog>
	<dialog id="ready-dialog" aria-labelledby="ready-dialog-title" data-effect="if ($readyOpen && !el.open) el.showModal(); else if (!$readyOpen && el.open) el.close()" data-on:close="$readyOpen = false" data-on:cancel="$readyOpen = false">
		@dialog.Title(dialog.TitleProps{ID: "ready-dialog-title"}) {
			Force this card to Done?
		}
		@dialog.Description() {
			CI, review and mergeability checks will be skipped. Inspect the pull request manually before confirming. This only moves the card to Done; it does not merge the PR or make any changes on GitHub or Forgejo.
		}
		<form method="post" action="/cards/force-ready" data-on:submit__prevent="@post('/cards/force-ready', {contentType:'form'})">
			<input type="hidden" name="_csrf" value={ d.csrf }/>
			@viewFields(d.v)
			<input type="hidden" name="card_id" data-bind:ready-card/>
			<input type="hidden" name="expected" data-bind:ready-token/>
			<p data-show="$readyPR !== ''"><a data-attr:href="$readyPR" data-text="$readyPR" target="_blank" rel="noopener noreferrer">Pull request</a></p>
			@label.Label(label.Props{For:"ready-pr-number", Attributes: templ.Attributes{"data-show": "$readyPR === ''"}}) {
				PR number
				@input.Input(input.Props{ID:"ready-pr-number", Type: "number", Name: "pr_number", Attributes: templ.Attributes{"min": "1", "step": "1", "data-bind:ready-number": true, "data-attr:disabled": "$readyPR !== ''", "data-attr:required": "$readyPR === ''"}})
			}
			@label.Label(label.Props{For:"ready-reason"}) {
				Reason (optional, at most 1000 bytes)
				@textarea.Textarea(textarea.Props{ID:"ready-reason", Name: "reason", Attributes: templ.Attributes{"data-bind:ready-reason": true}})
			}
			@label.Label(label.Props{ID:"ready-acknowledge-label", For:"ready-acknowledge"}) {
				@acknowledgement("ready-acknowledge", "acknowledge", "readyAcknowledged", "true")
				I understand that CI, review and readiness checks are bypassed and I have inspected the PR manually.
			}
			@dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Class: "btn", Attributes: templ.Attributes{"data-on:click": "$readyOpen = false"}}) {
					<span data-text="'Keep in ' + $readyLane">Keep in lane</span>
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Type: button.TypeSubmit, Class: "btn danger"}) {
					Force ready
				}
			}
		</form>
	</dialog>
	<form id="move-form" hidden data-on:submit__prevent="@post('/cards/move', {contentType:'form'})">
		<input type="hidden" name="_csrf" value={ d.csrf }/>
		@viewFields(d.v)
		<input name="card_id"/>
		<input name="status"/>
		<input name="position"/>
	</form>
}

templ auth(csrf, kind, msg string) {
	<!DOCTYPE html>
	<html lang="en">
		@head("Jawa · " + kind)
		<body class="style-nova auth-body">
			<main class="auth-wrap">
				@card.Card(card.Props{Class: "auth-card"}) {
					<div class="auth-brand">
						@logo(40)
						<span>Jawa</span>
					</div>
					if kind == "setup" {
						<h1>Set up your workspace</h1>
						<p class="muted">Create your administrator account. Use a password of at least 12 characters.</p>
					} else {
						<h1>Welcome back</h1>
						<p class="muted">Sign in to your engineering workspace.</p>
					}
					if msg != "" {
						@alert.Alert(alert.Props{Class: "notice"}) {
							{ msg }
						}
					}
					<form method="post" action={ "/" + kind }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<div class="field">
							@label.Label(label.Props{For: "auth-user"}) {
								Username
							}
							@input.Input(input.Props{ID: "auth-user", Name: "username", Required: true, Attributes: templ.Attributes{"autocomplete": "username"}})
						</div>
						<div class="field">
							@label.Label(label.Props{For: "auth-password"}) {
								Password
							}
							@input.Input(input.Props{ID: "auth-password", Name: "password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": passwordAutocomplete(kind), "minlength": passwordMinLength(kind)}})
						</div>
						if kind == "setup" {
							@submit("Create administrator")
						} else {
							@submit("Sign in")
						}
					</form>
				}
			</main>
		</body>
	</html>
}

func pageEventsURL(d pageData) string {
	if d.detail != nil {
		return "/runs/" + d.detail.Attempt.ID + "/events?tab=" + d.detail.Tab
	}
	return d.v.EventsURL()
}

// Attributes on Checkbox target its span, not the adjacent native input.
// The wrapper bridges native changes and signal-driven dialog resets.
templ acknowledgement(id, name, signal, required string) {
	<span class="acknowledgement" data-effect={ "window.jawaSyncAcknowledgement(el, $" + signal + ", " + required + ")" } data-on:change={ "$" + signal + " = evt.target.checked" }>
		@checkbox.Checkbox(checkbox.Props{ID: id, Name: name, Value: "yes", Required: required == "true", Attributes:templ.Attributes{"aria-labelledby":id+"-label"}})
	</span>
}
