package orchestrator

import (
 "time"
 "fmt"
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/breadcrumb"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/kbd"
	"github.com/axadrn/shadcn-templ/v2/components/label"

	"net/http"
)

func authPageWithRequest(w http.ResponseWriter, r *http.Request, kind, msg string) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	_ = auth(CSRFToken(r), kind, msg).Render(r.Context(), w)
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
		<meta name="color-scheme" content="dark"/>
		<meta name="theme-color" content="#130f0b"/>
		<meta name="description" content="Jawa — your coding agent workspace. Plan tasks, follow builds, and manage agents."/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-title" content="Jawa"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
		<link rel="manifest" href="/assets/manifest.webmanifest"/>
		<link rel="apple-touch-icon" href="/assets/icon-180.png"/>
		<title>{ title }</title>
		<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
		<link rel="preload" href="/assets/inter.woff2" as="font" type="font/woff2" crossorigin/>
		// Keep this first-paint fallback aligned with frontend/src/style.css.
		// Full styling and contextual icon sizes remain in the external stylesheet.
		<style>
			html, body { background: #130f0b; color: #eee2cf; }
			body { margin: 0; font: 13px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
			.ic { width: 16px; height: 16px; flex: none; }
			.lane-ic, .tone-ic { width: 15px; height: 15px; flex: none; }
		</style>
		<link rel="stylesheet" href={ templ.SafeURL(assetURL("style.css")) }/>
		<script type="module" src={ templ.SafeURL(assetURL("app.js")) }></script>
	</head>
}

// logo is the Jawa mark: a hooded figure whose two eyes glow amber.
templ logo(size int) {
	<svg class="logo" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 32 32" aria-hidden="true">
		<path d="M16 2.5c-6.4 0-10.5 5-10.5 11.4V25c0 2.2 1.6 4.2 4.2 4.2h12.6c2.6 0 4.2-2 4.2-4.2V13.9C26.5 7.5 22.4 2.5 16 2.5z" fill="#3b2d1d" stroke="#6b5036" stroke-width="1"></path>
		<path d="M9.2 15.2c0-3.2 2.9-5.4 6.8-5.4s6.8 2.2 6.8 5.4v2.2c0 2.6-2.9 4.6-6.8 4.6s-6.8-2-6.8-4.6z" fill="#0d0a07"></path>
		<circle cx="12.6" cy="15.6" r="3" fill="#ffb000" opacity=".18"></circle>
		<circle cx="19.4" cy="15.6" r="3" fill="#ffb000" opacity=".18"></circle>
		<circle cx="12.6" cy="15.6" r="1.35" fill="#ffc533"></circle>
		<circle cx="19.4" cy="15.6" r="1.35" fill="#ffc533"></circle>
	</svg>
}

templ icon(name string) {
	<svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "archive":
				<rect x="3" y="4" width="18" height="4" rx="1"></rect>
				<path d="M5 8v12h14V8M10 12h4"></path>
			case "eye":
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "board":
				<rect x="3" y="3" width="7" height="18" rx="1.5"></rect>
				<rect x="14" y="3" width="7" height="11" rx="1.5"></rect>
			case "runs":
				<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
			case "agents":
				<rect x="4" y="8" width="16" height="12" rx="3"></rect>
				<path d="M12 8V5"></path>
				<circle cx="12" cy="3.7" r="1.2"></circle>
				<circle cx="9" cy="14" r="1.1" fill="currentColor"></circle>
				<circle cx="15" cy="14" r="1.1" fill="currentColor"></circle>
			case "settings":
				<path d="M4 7h9M17 7h3M4 17h3M11 17h9"></path>
				<circle cx="15" cy="7" r="2"></circle>
				<circle cx="9" cy="17" r="2"></circle>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "more":
				<circle cx="5.5" cy="12" r="1.2" fill="currentColor"></circle>
				<circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
				<circle cx="18.5" cy="12" r="1.2" fill="currentColor"></circle>
			case "search":
				<circle cx="11" cy="11" r="6.5"></circle>
				<path d="m20 20-4-4"></path>
			case "branch":
				<circle cx="6" cy="5.5" r="2"></circle>
				<circle cx="6" cy="18.5" r="2"></circle>
				<circle cx="18" cy="9" r="2"></circle>
				<path d="M6 7.5v9M18 11c0 4-12 2-12 6"></path>
			case "pr":
				<circle cx="6" cy="5.5" r="2"></circle>
				<circle cx="6" cy="18.5" r="2"></circle>
				<circle cx="18" cy="18.5" r="2"></circle>
				<path d="M6 7.5v9M18 16.5V10a3 3 0 0 0-3-3h-3m2-2.5-2 2.5 2 2.5"></path>
			case "issue":
				<circle cx="12" cy="12" r="8.5"></circle>
				<circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
			case "external":
				<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
			case "copy":
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
			case "warning":
				<path d="M12 3 2 21h20L12 3z"></path>
				<path d="M12 9v5M12 17v.1"></path>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7"></path>
			case "trash":
				<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path>
			case "reset":
				<path d="M4 9h10a5 5 0 0 1 0 10H8M4 9l4-4M4 9l4 4"></path>
			case "play":
				<path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
			case "retry":
				<path d="M20 11a8 8 0 1 0-2.3 6M20 4v7h-7"></path>
			case "logout":
				<path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M15 8l4 4-4 4M19 12H9"></path>
			case "key":
				<circle cx="8" cy="15" r="4"></circle>
				<path d="m11 12 8-8M16 7l3 3"></path>
			case "server":
				<rect x="3" y="4" width="18" height="7" rx="2"></rect>
				<rect x="3" y="13" width="18" height="7" rx="2"></rect>
				<path d="M7 7.5h.01M7 16.5h.01"></path>
		}
	</svg>
}

// laneIcon is the Linear-style status glyph shown on board columns.
templ laneIcon(status string) {
	<svg class={ "ic lane-ic lane-" + status } width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		switch status {
			case "Todo":
				<circle cx="12" cy="12" r="8" stroke-dasharray="3.2 3.2"></circle>
			case "Planning":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M9 9h6M9 12h6M9 15h3"></path>
			case "Fix":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M8 9a5 5 0 1 1-1 5M8 6v4H4"></path>
			case "Building":
				<circle cx="12" cy="12" r="8"></circle>
				<path d="M12 7a5 5 0 0 1 0 10z" fill="currentColor" stroke="none"></path>
			default:
				<circle cx="12" cy="12" r="8.5" fill="currentColor" stroke="none"></circle>
				<path d="m8.4 12.3 2.5 2.5 4.8-5.2" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
		}
	</svg>
}

// toneIcon is the glyph for an attempt's state.
templ toneIcon(tone string) {
	<svg class={ "ic tone-ic tone-" + tone } width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch tone {
			case "running":
				<circle cx="12" cy="12" r="8"></circle>
				<path class="spin" d="M12 4a8 8 0 0 1 8 8" stroke-width="3"></path>
			case "blocked":
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M12 7.5v5M12 15.8h.01"></path>
			case "failed":
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="m9 9 6 6M15 9l-6 6"></path>
			case "ready":
				<circle cx="12" cy="12" r="8.5" fill="currentColor" stroke="none"></circle>
				<path d="m8.4 12.3 2.5 2.5 4.8-5.2" stroke="var(--bg)"></path>
			default:
				<circle cx="12" cy="12" r="8" stroke-dasharray="1.5 3.4"></circle>
		}
	</svg>
}

templ submit(title string) {
	@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeSubmit, Class: "btn primary"}) {
		{ title }
	}
}

templ textField(id, name, title, value string, required bool, attrs templ.Attributes) {
	<div class="field">
		@label.Label(label.Props{For: id}) {
			{ title }
		}
		@input.Input(input.Props{ID: id, Name: name, Value: value, Required: required, Attributes: attrs})
	</div>
}

// viewFields keeps mutations aware of the screen they came from, so the
// response patches the right roots.
templ viewFields(v viewParams) {
	<input type="hidden" name="view" value={ string(v.View) }/>
	<input type="hidden" name="project" value={ v.Project }/>
	<input type="hidden" name="card" value={ v.Card }/>
	<input type="hidden" name="state" value={ v.State }/>
}

func viewLabel(v viewKind) string {
	switch v {
	case viewArchive:
		return "Archive"
	case viewPlanning:
		return "Planning"
	case viewRuns:
		return "Runs"
	case viewAgents:
		return "Agents"
	case viewSettings:
		return "Settings"
	}
	return "Board"
}

func pageTitle(d pageData) string {
	if d.v.View == viewBoard {
		if p, ok := projectByID(d.projects, d.v.Project); ok {
			return p.Name + " · Jawa"
		}
	}
	return viewLabel(d.v.View) + " · Jawa"
}

func shellSignals() string {
	return "{runDraft:'',runSending:false,runConfirmedDraft:'',runAcceptedMessage:'',_retryText:null,traceFilter:'',filter:'',goto:'',prRefreshing:false,_dialogOpen:false,_dialogReturn:'',_menuOpen:false,_menuActed:false,_dragging:false,_typing:false,_g:0}"
}

func isCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ appPage(d pageData) {
	<!DOCTYPE html>
	<html lang="en">
		@head(pageTitle(d))
		<body class="style-nova app">
			<div
				class="shell"
                data-signals:_now="Date.now()"
                data-on-interval__duration.15s="$_now = Date.now()"
				data-signals={ shellSignals() }
				data-init={ "@get('" + pageEventsURL(d) + "')" }
				data-effect="if ($goto.startsWith('/')) window.location.assign($goto)"
				data-on:board-refresh={ d.v.SnapshotAction() }
 data-on:dropdownmenu-open-change__window={ "$_menuOpen = evt.detail.open; evt.detail.open ? ($_menuActed = false) : ($_menuActed || " + d.v.SnapshotAction() + ")" }
 data-on:datastar-fetch__window="evt.detail.type === 'retries-failed' && ($prRefreshing = false)"
 data-on:focusin="$_typing = evt.target.matches('input,textarea,[role=combobox],[contenteditable=true]')"
 data-on:focusout="$_typing = false"
 data-computed:_shortcuts="!$_typing && !$_dialogOpen"
 data-computed:_goto-key="({b: '/board', r: '/runs', a: '/agents', s: '/settings'})"
 data-on:keydown__window="$_shortcuts && !evt.metaKey && !evt.ctrlKey && !evt.altKey && !evt.isComposing && ($_gotoKey[evt.key] && Date.now() - $_g < 1200 ? (evt.preventDefault(), $_g = 0, $goto = $_gotoKey[evt.key]) : evt.key === 'g' ? $_g = Date.now() : evt.key === 'c' ? (evt.preventDefault(), $_g = 0, @get('/dialogs/card')) : evt.key === '/' && $cardFilter ? (evt.preventDefault(), $_g = 0, $cardFilter.select()) : $_g = 0)"
			>
				@sidebar(d)
				<div class="main">
					@topbar(d)
					<main class="content" id="content">
						@notification("", "")
						switch d.v.View {
							case viewArchive:
								@archiveContent(d)
							case viewPlanning:
								@planningContent(d)
							case viewRuns:
								if d.detail != nil {
									@runDetailPage(*d.detail, d.csrf)
								} else {
									@runsContent(d)
								}
							case viewAgents:
								@agentsContent(d)
							case viewSettings:
								@settingsContent(d)
							default:
								@boardContent(d)
						}
					</main>
				</div>
				<div id="dialog-slot"></div>
<form id="move-form" data-on:board-move__window__delay.1ms="@post('/cards/move', {contentType:'form', selector: '#move-form'})" data-signals="{moveCard: '', moveStatus: '', movePosition: ''}" hidden data-on:submit__prevent="@post('/cards/move', {contentType:'form'})">
		<input type="hidden" name="_csrf" value={ d.csrf }/>
		@viewFields(d.v)
		<input name="card_id" data-bind:move-card/>
		<input name="status" data-bind:move-status/>
		<input name="position" data-bind:move-position/>
	</form>

			</div>
		</body>
	</html>
}

templ sidebar(d pageData) {
	<aside class="sidebar">
		<a class="brand" href="/board">
			@logo(26)
			<span class="brand-name">Jawa</span>
			<span class="brand-tag">Orchestrator</span>
		</a>
		@sidebarNav(d)
		<div class="sidebar-foot">
			<div class="hints" aria-label="Keyboard shortcuts">
				<span>@kbd.Kbd() {
	C
}</span><span>new card</span>
				<span>@kbd.Kbd() {
	/
}</span><span>filter</span>
				<span>@kbd.Kbd() {
	G
}@kbd.Kbd() {
	B
}</span><span>go to…</span>
			</div>
			<form method="post" action="/logout">
				<input type="hidden" name="_csrf" value={ d.csrf }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "nav-item nav-quiet", Size: button.SizeSm, Variant: button.VariantGhost}) {
					@icon("logout")
					<span>Sign out</span>
				}
			</form>
		</div>
	</aside>
}

// sidebarNav is a live patch root: counts follow the work in progress.
templ sidebarNav(d pageData) {
	<nav id="sidebar-nav" class="nav" aria-label="Primary">
		<div class="nav-group">
			<div class="nav-label">Workspace</div>
			<a class="nav-item" href="/archive" aria-current={ isCurrent(d.v.View == viewArchive) }>
				@icon("archive")
				<span>Archive</span>
			</a>
			<a class="nav-item" href="/runs" aria-current={ isCurrent(d.v.View == viewRuns) }>
				@icon("runs")
				<span>Runs</span>
				if n := countHistory(d.runs, "active"); n > 0 {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "nav-count live"}) {
						{ strconv.Itoa(n) }
					}
				}
			</a>
			<a class="nav-item" href="/agents" aria-current={ isCurrent(d.v.View == viewAgents) }>
				@icon("agents")
				<span>Agents</span>
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: templ.Classes("nav-count", templ.KV("online", readyAgents(d.agents) > 0)).String()}) {
					{ strconv.Itoa(readyAgents(d.agents)) }
				}
			</a>
			<a class="nav-item" href="/settings" aria-current={ isCurrent(d.v.View == viewSettings) }>
				@icon("settings")
				<span>Settings</span>
			</a>
		</div>
		<div class="nav-group">
			<div class="nav-label nav-label-row">
				<span>Projects</span>
				@button.Button(button.Props{Type: button.TypeButton, Class: "icon-btn", Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"aria-label": "New project", "data-on:click": dialogOpen("project", "", "")}}) {
					@icon("plus")
				}
			</div>
			for _, p := range d.projects {
				{{ work := projectWork(d.uiSnapshot, p.ID) }}
				<a aria-label={ p.Name + ": " + work.Label() } class="nav-item" href={ templ.SafeURL(boardPath(p.ID)) } aria-current={ isCurrent(d.v.View == viewBoard && d.v.Project == p.ID) } data-project-id={ p.ID } data-project-name={ p.Name }>
					<span class="proj-mark">{ initial(p.Name) }</span>
					<span class="nav-text">{ p.Name }</span>
					if work.Total() > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "nav-count live", Attributes: templ.Attributes{"title": work.Label()}}) {
							{ strconv.Itoa(work.Total()) }
						}
					}
				</a>
			}
			if len(d.projects) == 0 {
				<p class="nav-empty">No projects yet.</p>
			}
		</div>
	</nav>
}

templ topbar(d pageData) {
	<header class="topbar">
		@breadcrumb.Breadcrumb() {
			@breadcrumb.List() {
				@breadcrumb.Item() {
					@breadcrumb.Link(breadcrumb.LinkProps{Href: "/board"}) {
						Workspace
					}
				}
				@breadcrumb.Separator()
				@breadcrumb.Item() {
					if _, ok := projectByID(d.projects, d.v.Project); ok && d.v.View == viewBoard {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "/board"}) {
							Board
						}
					} else {
						@breadcrumb.Page() {
							{ viewLabel(d.v.View) }
						}
					}
				}
				if d.v.View == viewBoard {
					if p, ok := projectByID(d.projects, d.v.Project); ok {
						@breadcrumb.Separator()
						@breadcrumb.Item() {
							@breadcrumb.Page() {
								{ p.Name }
							}
						}
					}
				}
			}
		}
		<div class="topbar-actions">
			if d.v.View == viewBoard || d.v.View == viewArchive {
				<div class="search">
					@icon("search")
					@input.Input(input.Props{ID: "card-filter", Class: "filter", Placeholder: "Filter cards", Attributes: templ.Attributes{"aria-label": "Filter cards", "data-ref:card-filter": true, "data-bind:filter": "", "autocomplete": "off"}})
					@kbd.Kbd() {
						/
					}
				</div>
			}
			@agentStatus(d)
			if len(d.projects) > 0 {
				@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeButton, Class: "btn primary", Attributes: templ.Attributes{"data-on:click": dialogOpen("card", "", "")}}) {
					@icon("plus")
					New card
				}
			}
		</div>
	</header>
}

// agentStatus is a live patch root present on every screen.
templ agentStatus(d pageData) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, ID: "agent-status", Class: templ.Classes("agent-chip", templ.KV("online", readyAgents(d.agents) > 0), templ.KV("degraded", !d.presence)).String(), Href: "/agents", Attributes: templ.Attributes{"title": "Open agents", "hidden": d.detail != nil && (!d.presence || readyAgents(d.agents) == 0)}}) {
		if d.detail == nil || (d.presence && readyAgents(d.agents) > 0) {
			<span class="pulse-dot"></span>
			if !d.presence {
				<span>Presence unavailable</span>
			} else if n := readyAgents(d.agents); n == 0 {
				<span>No agents online</span>
			} else if n == 1 {
				<span>1 agent online</span>
			} else {
				<span>{ strconv.Itoa(n) } agents online</span>
			}
		}
	}
}

// notification is an independent patch root; errors never discard a draft.
templ notification(message, tone string) {
	@alert.Alert(alert.Props{ID: "notice", Class: "notice " + tone, Attributes: templ.Attributes{"role": "alert", "aria-live": "polite", "hidden": message == ""}}) {
		{ message }
	}
}

// Operation-keyed roots isolate responses from a dismissed/reopened dialog.
templ dialogError(name, operation, message string) {
	@alert.Alert(alert.Props{ID: dialogErrorID(name, operation), Class: "notice dialog-error", Attributes: templ.Attributes{"role": "alert", "aria-live": "polite", "hidden": message == ""}}) {
		{ message }
	}
}


templ auth(csrf, kind, msg string) {
	<!DOCTYPE html>
	<html lang="en">
		@head("Jawa · " + kind)
		<body class="style-nova auth-body">
			<main class="auth-wrap">
				@card.Card(card.Props{Class: "auth-card"}) {
					<div class="auth-brand">
						@logo(40)
						<span>Jawa</span>
					</div>
					if kind == "setup" {
						<h1>Set up your workspace</h1>
						<p class="muted">Create your administrator account. Use a password of at least 12 characters.</p>
					} else {
						<h1>Welcome back</h1>
						<p class="muted">Sign in to your engineering workspace.</p>
					}
					if msg != "" {
						@alert.Alert(alert.Props{Class: "notice"}) {
							{ msg }
						}
					}
					<form method="post" action={ "/" + kind }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<div class="field">
							@label.Label(label.Props{For: "auth-user"}) {
								Username
							}
							@input.Input(input.Props{ID: "auth-user", Name: "username", Required: true, Attributes: templ.Attributes{"autocomplete": "username"}})
						</div>
						<div class="field">
							@label.Label(label.Props{For: "auth-password"}) {
								Password
							}
							@input.Input(input.Props{ID: "auth-password", Name: "password", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": passwordAutocomplete(kind), "minlength": passwordMinLength(kind)}})
						</div>
						if kind == "setup" {
							@submit("Create administrator")
						} else {
							@submit("Sign in")
						}
					</form>
				}
			</main>
		</body>
	</html>
}

func pageEventsURL(d pageData) string {
	if d.detail != nil {
		return detailAction(*d.detail, "events")
	}
	return d.v.EventsURL()
}

// relTime remains meaningful without scripts and refreshes from the shell clock.
templ relTime(t, now time.Time) {
 if t.IsZero() {
 <span>—</span>
 } else {
 <time datetime={ timeAttr(t) } title={ t.UTC().Format("2006-01-02 15:04:05 UTC") } data-text={ relTimeExpr(t) } data-attr:title={ fmt.Sprintf("new Date(%d).toLocaleString()", t.UnixMilli()) }>{ relativeTime(t, now) }</time>
 }
}

templ pendingSubmit(title, sig string) {
 @button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-attr:disabled": "$_" + sig}}) { { title } }
}
