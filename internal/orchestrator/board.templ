package orchestrator

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
)

templ boardContent(d pageData) {
	<div id="board-content" class="view board-view">
		if p, ok := selectedProject(d.projects, d.v.Project); ok {
			<div class="view-head">
				<div class="view-title project-heading">
					<div class="project-title-row">
						<span class="proj-mark lg">{ initial(p.Name) }</span>
						<h1>{ p.Name }</h1>
					</div>
					<p class="meta">
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip plain"}) {
							{ providerLabel(p.Provider) }
						}
						if u := repoURL(p.Repo); u != "" {
							<a class="meta-link" href={ templ.SafeURL(u) } target="_blank" rel="noopener noreferrer">{ repoLabel(p.Repo) }</a>
						} else {
							<span>{ repoLabel(p.Repo) }</span>
						}
						<span class="meta-sep">·</span>
						<span class="meta-unit">@icon("branch") <span>{ p.BaseBranch }</span></span>
					</p>
				</div>
				<div class="view-stats">
					{{ work := projectWork(d.uiSnapshot, p.ID) }}
					<span role="group" class="stat" title={ work.Label() } aria-label={ work.Label() }><strong>{ strconv.Itoa(work.Total()) }</strong> active</span>
					<span class="stat"><strong>{ strconv.Itoa(len(cardsIn(d.cards, p.ID, "Done"))) }</strong> ready</span>
				</div>
			</div>
			<jawa-board project={ p.ID }>
				<div class="lanes">
					for _, status := range []string{"Todo", "Planning", "Building", "Fix", "Done"} {
						<section class={ "lane", "lane-" + status } aria-label={ laneName(status) }>
							<header class="lane-head">
								@laneIcon(status)
								<h2>{ laneName(status) }</h2>
								@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "lane-count"}) {
									{ strconv.Itoa(len(cardsIn(d.cards, p.ID, status))) }
								}
								if status == "Todo" {
									@button.Button(button.Props{Type: button.TypeButton, Class: "icon-btn lane-add", Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"aria-label": "New card", "data-on:click": "$cardOpen = true"}}) {
										@icon("plus")
									}
								}
							</header>
							<div class="lane-actions">
								if status == "Done" {
									@prRefreshForm(d, p.ID, "", "Refresh ready PRs")
								}
							</div>
							<div id={ "lane-" + p.ID + "-" + status } class="task-list" data-status={ status }>
								for _, c := range cardsIn(d.cards, p.ID, status) {
									@taskCard(d, c)
								}
								if len(cardsIn(d.cards, p.ID, status)) == 0 {
									<p class="lane-empty">{ laneHint(status) }</p>
								}
							</div>
						</section>
					}
				</div>
			</jawa-board>
		} else {
			@empty.Empty(empty.Props{Class: "page-empty"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon("board")
					}
					@empty.Title() {
						Create your first project
					}
					@empty.Description() {
						Connect a GitHub or Forgejo repository. Cards you move to Building are built by an agent and arrive as pull requests.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Variant: button.VariantDefault, Type: button.TypeButton, Class: "btn primary", Attributes: templ.Attributes{"data-on:click": "$projectOpen = true"}}) {
						@icon("plus")
						New project
					}
				}
			}
		}
	</div>
}

templ taskCard(d pageData, c Card) {
	@card.Card(card.Props{ID: "card-" + c.ID, Class: "task-card", Attributes: templ.Attributes{"data-card-id": c.ID, "data-title": c.Title, "data-status": c.Status, "data-can-fix": strconv.FormatBool(canAction(c, d.attempts, "fix")), "data-show": filterExpr(d.projects, c)}}) {
		<div class="card-top">
			<a class="card-key" href={ templ.SafeURL(planningPath(c.ID)) } title="View card and plan">{ cardKey(d.projects, c) }</a>
			<div class="card-tools">
				@archiveButton(d, c)
				@button.Button(button.Props{Class: "icon-btn card-view-action", Href: planningPath(c.ID), Type: button.TypeButton, Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "link", "aria-label": "View card and plan: " + cardKey(d.projects, c), "title": "View card and plan"}}) {
					@icon("eye")
				}
				@cardMenu(d, c)
			</div>
		</div>
		<h3 class="card-title">{ c.Title }</h3>
		if c.Description != "" {
			<p class="card-desc">{ c.Description }</p>
		}
		<div class="card-meta">
			@cardChips(d, c)
		</div>
		@cardNote(d, c)
	}
}

templ cardChips(d pageData, c Card) {
	if c.Status == "Planning" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Href: runsForCardPath(c.ID), Attributes: templ.Attributes{"title": "View runs"}, Class: templ.Classes("chip", "planning-badge", "tone-"+planningTone(planningState(d, c.ID))).String()}) {
			@toneIcon(planningTone(planningState(d, c.ID)))
			<span>{ planningAssignmentLabel(d, c.ID) }</span>
		}
	}
	if la := latestAttempt(c.ID, d.attempts); len(la) > 0 {
		if c.Status != "Planning" {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: templ.Classes("chip", "tone-"+runTone(la[0])).String(), Href: runsForCardPath(c.ID), Attributes: templ.Attributes{"title": "View runs"}}) {
				@toneIcon(runTone(la[0]))
				if d.prChecks[c.ID].State == "merged" && la[0].Ready {
					<span>Merged</span>
				} else {
					<span>{ d.runLabel(la[0]) }</span>
				}
			}
		}
	} else if c.Status == "Building" || c.Status == "Fix" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip tone-queued"}) {
			@toneIcon("queued")
			<span>Not started</span>
		}
	}
	@assignedAgent(d.cardAgent(c))
	if la := latestAttempt(c.ID, d.attempts); len(la) > 0 {
		@manualReadyBadge(d, la[0])
		if pr := cardPRURL(c, la[0]); pr != "" {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip", Href: pr, Attributes: templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "title": "Open pull request"}}) {
				@icon("pr")
				<span>PR</span>
			}
		}
	}
	if iss := safeActivityURL(c.IssueURL); iss != "" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip", Href: iss, Attributes: templ.Attributes{"target": "_blank", "rel": "noopener noreferrer", "title": "Open linked issue"}}) {
			@icon("issue")
			<span>Issue</span>
		}
	}
	{{ updated := d.cardActivity(c) }}
	<span class="chip-time">
		<jawa-time datetime={ timeAttr(updated) }>{ relativeTime(updated, d.now) }</jawa-time>
	</span>
}

templ assignedAgent(agentID string) {
	if agentID != "" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip plain", Attributes: templ.Attributes{"title": "Assigned agent"}}) {
			@icon("agents")
			<span>{ agentID }</span>
		}
	}
}

templ cardNote(d pageData, c Card) {
	if note := d.automaticResumeNote(c); note != "" {
		<p class="muted small" role="status">{ note }</p>
	}
	if canAction(c, d.attempts, "fix") {
		@cardPRStatus(d, c)
	}
	if b, ok := d.blocker(c); ok {
		@alert.Alert(alert.Props{Class: "card-note tone-blocked", Attributes: templ.Attributes{"aria-live": "polite"}}) {
			<p><strong>Blocked:</strong> { b.Reason }</p>
			if b.Queued {
				<p class="muted small">{ guidanceQueuedNotice }</p>
			} else {
				@button.Button(button.Props{Type: button.TypeButton, Class: "btn small", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-on:click": guideDialogAction(c.ID, b.Token)}}) {
					Reply with guidance…
				}
			}
		}
	}
	if note, tone := d.cardDiagnostic(c); note != "" {
		@alert.Alert(alert.Props{Class: "card-note tone-" + tone}) {
			{ note }
		}
	}
}

// cardMenu is a Rocket-managed popover: the component positions the native
// popover next to its trigger and closes it after an action is chosen.
templ cardMenu(d pageData, c Card) {
	<jawa-menu>
		@button.Button(button.Props{Type: button.TypeButton, Class: "icon-btn", Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"popovertarget": "menu-" + c.ID, "aria-label": "Actions for " + c.Title, "aria-haspopup": "menu"}}) {
			@icon("more")
		}
		<div id={ "menu-" + c.ID } class="menu" popover="auto" role="menu" data-preserve-attr="style">
			if c.Status == "Done" {
				if canAction(c, d.attempts, "fix") {
					if d.prChecks[c.ID].State != "merged" {
						{{ attempt := latestAttempt(c.ID, d.attempts)[0] }}
						@menuPost(d, c, "/cards/mark-merged", "Mark as merged", "check", [][2]string{{"expected_attempt_id", attempt.ID}, {"expected_pr_url", attempt.PRURL}})
					}
					@assignmentMenu(c, "fix", "Fix with agent")
					@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item", Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": fixDialogAction(c.ID, "")}}) {
						@icon("retry")
						<span>Send to Fix…</span>
					}
				} else {
					@menuDisabled("Send to Fix", "retry", "Fix requires a verified pull request and no active attempt.")
				}
			}
			if c.Status == "Todo" {
				@assignmentMenu(c, "plan", "Plan with agent")
				@assignmentMenu(c, "build", "Build with agent")
				@menuPost(d, c, "/cards/plan", "Plan first", "runs", nil)
				@menuPost(d, c, "/cards/move", "Start work", "play", [][2]string{{"status", "Building"}, {"position", "0"}})
			}
			if canAction(c, d.attempts, "start") {
				@menuPost(d, c, "/cards/retry", "Start work", "play", nil)
			}
			if c.Status == "Planning" {
				@assignmentMenu(c, "build", "Build with agent")
				if detail, ok := d.planning[c.ID]; ok && detail.CanResume {
					@menuPost(d, c, "/cards/planning/resume", "Resume failed run", "play", [][2]string{{"expected_resume", detail.ResumeToken}})
				}
			} else if canAction(c, d.attempts, "resume") {
				@menuPost(d, c, "/cards/resume", "Resume failed run", "play", [][2]string{{"expected_resume", resumeToken(latestAttempt(c.ID, d.attempts)[0])}})
			}
			if d.canGuide(c) {
				{{ b, _ := d.blocker(c) }}
				@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item", Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": guideDialogAction(c.ID, b.Token)}}) {
					@icon("play")
					<span>Reply with guidance…</span>
				}
			}
			if canAction(c, d.attempts, "retry") {
				@menuPost(d, c, "/cards/retry", "Retry attempt", "retry", nil)
			}
			if c.Status == "Planning" {
				@menuPost(d, c, "/cards/planning/cancel", "Cancel planning", "reset", nil)
			}
			if c.Status != "Todo" && c.Status != "Planning" {
				if d.canReset(c) {
					@menuPost(d, c, "/cards/reset", "Reset to Todo", "reset", nil)
				} else {
					@menuDisabled("Reset to Todo", "reset", d.resetReason(c))
				}
			}
			if c.Status == "Building" || c.Status == "Fix" {
				if canAction(c, d.attempts, "cancel") {
					@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item danger", Size: button.SizeSm, Variant: button.VariantDestructive, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": "$cancelCard = " + strconv.Quote(c.ID) + "; $cancelOpen = true"}}) {
						@icon("reset")
						<span>Cancel run…</span>
					}
				} else {
					@menuDisabled("Cancel run", "reset", "Cancellation requires an active run with a confirmed agent and remote target.")
				}
			}
			if d.canForceReady(c) {
				@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item danger", Size: button.SizeSm, Variant: button.VariantDestructive, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": d.readyDialogAction(c)}}) {
					@icon("check")
					<span>Force ready…</span>
				}
			}
			if canAction(c, d.attempts, "force-stop") {
				@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item danger", Size: button.SizeSm, Variant: button.VariantDestructive, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": "$forceCard = " + strconv.Quote(c.ID) + "; $forceAcknowledged = false; $forceOpen = true"}}) {
					@icon("reset")
					<span>Force stop…</span>
				}
			}
			if d.hasRuns(c.ID) {
				@button.Button(button.Props{Class: "menu-item", Href: runsForCardPath(c.ID), Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem"}}) {
					@icon("runs")
					<span>View runs</span>
				}
			}
			if iss := safeActivityURL(c.IssueURL); iss != "" {
				@button.Button(button.Props{Class: "menu-item", Href: iss, Target: "_blank", Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem", "rel": "noopener noreferrer"}}) {
					@icon("external")
					<span>Open issue</span>
				}
			}
			@button.Button(button.Props{Class: "menu-item", Href: planningPath(c.ID), Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem"}}) {
				View card &amp; plan
			}
			@separator.Separator(separator.Props{Class: "menu-sep"})
			if canAction(c, d.attempts, "delete") {
				@button.Button(button.Props{Type: button.TypeButton, Class: "menu-item danger", Size: button.SizeSm, Variant: button.VariantDestructive, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": "$deleteCard = " + strconv.Quote(c.ID) + "; $deleteOrphan = " + strconv.FormatBool(cardNeedsReconciliation(c, d.attempts)) + "; $deleteAcknowledged = false; $deleteOpen = true"}}) {
					@icon("trash")
					<span>Delete…</span>
				}
			} else {
				@menuDisabled("Delete", "trash", actionReason(c, d.attempts, "delete"))
			}
		</div>
	</jawa-menu>
}

templ menuPost(d pageData, c Card, route, label, ic string, extra [][2]string) {
	<form method="post" action={ route } data-on:submit__prevent={ "@post('" + route + "', {contentType:'form'})" }>
		<input type="hidden" name="_csrf" value={ d.csrf }/>
		@viewFields(d.v)
		<input type="hidden" name="card_id" value={ c.ID }/>
		for _, kv := range extra {
			<input type="hidden" name={ kv[0] } value={ kv[1] }/>
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Class: "menu-item", Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem"}}) {
			@icon(ic)
			<span>{ label }</span>
		}
	</form>
}

templ menuDisabled(label, ic, reason string) {
	@button.Button(button.Props{Disabled: true, Class: "menu-item disabled", Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem", "aria-disabled": "true", "title": reason}}) {
		@icon(ic)
		<span>{ label }</span>
		<span class="menu-reason">{ reason }</span>
	}
}

// Refresh forms work natively and use finite SSE when Datastar is available.
templ prRefreshForm(d pageData, projectID, cardID, label string) {
	<form class="pr-refresh-form" method="post" action="/prs/refresh" data-on:submit__prevent="@post('/prs/refresh', {contentType:'form'})">
		<input type="hidden" name="_csrf" value={ d.csrf }/>
		<input type="hidden" name="project_id" value={ projectID }/>
		<input type="hidden" name="card_id" value={ cardID }/>
		@viewFields(d.v)
		@button.Button(button.Props{Type: button.TypeSubmit, Class: "btn small", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-attr:disabled": "$prRefreshing", "data-attr:aria-busy": "$prRefreshing ? 'true' : 'false'"}}) {
			<span data-show="!$prRefreshing">{ label }</span>
			<span class="pr-refresh-pending" style="display: none" data-show="$prRefreshing">
				<span class="pr-refresh-spinner" aria-hidden="true"></span>
				Refreshing ready PRs…
			</span>
		}
	</form>
}

templ cardPRStatus(d pageData, c Card) {
	{{ check := d.prChecks[c.ID] }}
	<div class={ "card-pr-status", templ.KV("card-conflict", check.State == "conflict") } role="status" data-pr-check-state={ check.State }>
		if check.State == "conflict" || check.State == "error" {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip tone-failed", Attributes: templ.Attributes{"title": prCheckLabel(check)}}) {
				if check.State == "conflict" {
					@icon("warning")
					Merge Conflict
				} else {
					@icon("warning")
					Checks Failed
				}
			}
		} else if check.State != "merged" {
			<p>{ prCheckLabel(check) }</p>
		}
		if check.Manual {
			<p class="pr-checked-at">Marked as merged manually <jawa-time datetime={ timeAttr(check.MarkedAt) } title={ check.MarkedAt.UTC().Format("2006-01-02 15:04:05 UTC") }>{ relativeTime(check.MarkedAt, d.now) }</jawa-time></p>
		} else if !check.CheckedAt.IsZero() {
			<p class="pr-checked-at">Last checked <jawa-time datetime={ timeAttr(check.CheckedAt) } title={ check.CheckedAt.UTC().Format("2006-01-02 15:04:05 UTC") }>{ relativeTime(check.CheckedAt, d.now) }</jawa-time></p>
		} else if check.State == "checking" {
			<p class="pr-checked-at">Awaiting a fresh check.</p>
		} else {
			<p class="pr-checked-at">No prior check recorded.</p>
		}
		if check.HeadSHA != "" || check.BaseSHA != "" {
			<details class="pr-evidence">
				<summary>Checked revision evidence</summary>
				if check.HeadSHA != "" {
					<p>Head: <code>{ check.HeadSHA }</code></p>
				}
				if check.BaseSHA != "" {
					<p>Base: <code>{ check.BaseSHA }</code></p>
				}
			</details>
		}
		if check.State == "conflict" {
			@button.Button(button.Props{Type: button.TypeButton, Class: "btn small conflict-fix", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-on:click": fixDialogAction(c.ID, conflictFixMessage)}}) {
				@icon("warning")
				Fix Merge Conflict
			}
		}
	</div>
}

// Archiving changes visibility only, including for cards with active work.
templ archiveButton(d pageData, c Card) {
	<form method="post" action={ archiveRoute(c) } data-on:submit__prevent={ "@post('" + archiveRoute(c) + "', {contentType:'form'})" }>
		<input type="hidden" name="_csrf" value={ d.csrf }/>
		@viewFields(d.v)
		<input type="hidden" name="card_id" value={ c.ID }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Class: "archive-action", Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"title": "Changes visibility only; work and history are preserved"}}) {
			@icon("archive")
			{ archiveLabel(c) }
		}
	</form>
}

func archiveRoute(c Card) string {
	if c.Archived {
		return "/cards/restore"
	}
	return "/cards/archive"
}

func archiveLabel(c Card) string {
	if c.Archived {
		return "Restore"
	}
	return "Archive"
}

templ archiveContent(d pageData) {
	<div id="archive-content" class="view archive-view">
		<div class="view-head">
			<div class="view-title"><div><h1>Archive</h1><p class="meta">Hidden from the board. Work and history are preserved.</p></div></div>
		</div>
		<div class="archive-grid">
			for _, c := range d.cards {
				if c.Archived && (d.v.Project == "" || d.v.Project == c.ProjectID) {
					@taskCard(d, c)
				}
			}
		</div>
		if !hasArchivedCards(d.cards, d.v.Project) {
			<p class="lane-empty">No archived cards. Use Archive on a card to hide it from the board.</p>
		}
	</div>
}

func hasArchivedCards(cards []Card, project string) bool {
	for _, c := range cards {
		if c.Archived && (project == "" || c.ProjectID == project) {
			return true
		}
	}
	return false
}

templ manualReadyBadge(d pageData, a Attempt) {
	if r,ok := d.readyOverrides[a.ID]; ok {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "chip", Attributes: templ.Attributes{"title": "Manually readied at " + r.MarkedAt.UTC().Format("2006-01-02 15:04:05.000 UTC")}}) {
			Manually readied
		}
	}
}

templ assignmentMenu(c Card, mode, title string) {
 @button.Button(button.Props{Type: button.TypeButton, Class: "menu-item", Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{"role": "menuitem", "data-on:click": assignmentAction(c, mode)}}) {
  @icon("agents")<span>{ title }</span>
 }
}
