package orchestrator

import (
 "strconv"
 "github.com/axadrn/shadcn-templ/v2/components/button"
 "github.com/axadrn/shadcn-templ/v2/components/dialog"
 "github.com/axadrn/shadcn-templ/v2/components/label"
 "github.com/axadrn/shadcn-templ/v2/components/textarea"
 "github.com/axadrn/shadcn-templ/v2/components/checkbox"
)

// Only the selected card's reviewed revision is included in an opening.
templ assignDialog(d pageData, op string, c Card, mode string, choices []AgentChoice, choicesErr error) {
 {{ needsAck := mode == "build" && c.Status == "Planning" && d.planning[c.ID].CanApprove }}
 @dialogFrame("assign", op, "Choose an agent") {
 @dialog.Description() { Targeted work may wait when an agent is busy or goes offline. There is no fallback to another agent. Planning and build agents are chosen independently. }
 <form method="post" action="/cards/assign" { dialogForm("assign", "/cards/assign")... }
 data-signals={ assignmentSignals(mode, needsAck) }
 data-computed:_assign-ready="!!$assignAgent && ($assignMode !== 'fix' || $assignMessage.trim() !== '') && (!$assignNeedsAck || $assignAck)">
 <input type="hidden" name="dialog_operation" value={ op }/>
 <input type="hidden" name="_csrf" value={ d.csrf }/>
 @viewFields(d.v)
 <input type="hidden" name="card_id" value={ c.ID }/>
 <input type="hidden" name="mode" value={ mode }/>
 @assignmentAgentField(choices, choicesErr)
 if mode == "fix" {
 <div class="field">
 @label.Label(label.Props{For: "assignment-message"}) { Fix message (required) }
 @textarea.Textarea(textarea.Props{ID: "assignment-message", Name: "message", Rows: 5, Attributes: templ.Attributes{"data-bind:assign-message": true, "required": true}})
 </div>
 }
 if needsAck {
 {{ detail := d.planning[c.ID] }}
 <section data-assignment-plan={ c.ID }>
 <h3>{ "Revision " + strconv.Itoa(detail.Session.Revision) }</h3>
 @planningMarkdownText(detail.Session.Spec)
 <input type="hidden" name="expected_revision" value={ strconv.Itoa(detail.Session.Revision) }/>
 <div data-on:change="$assignAck = evt.target.checked">
 @label.Label(label.Props{For: "assign-review-" + c.ID}) {
 @checkbox.Checkbox(checkbox.Props{ID: "assign-review-" + c.ID, Name: "acknowledge", Value: "yes", Required: true}) I reviewed this revision and want to start building.
 }
 </div>
 <a href={ templ.SafeURL(planningPath(c.ID)) }>Open planning view</a>
 </section>
 }
 @dialog.Footer(dialog.FooterProps{Class: "dialog-actions"}) {
 @button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: dialogClose(ctx)}) { Cancel }
 @button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-agent-submit": true, "data-attr:disabled": "$_assignPending || !$_assignReady"}}) { <span>{ assignLabel(mode, needsAck) }</span> }
 }
 </form>
 }
}

templ assignmentAgentField(choices []AgentChoice, choicesErr error) {
 <div id="assignment-agent-field" class="field" data-signals:assign-agent="''" data-on:change="evt.target.name === 'target_agent_id' && ($assignAgent = evt.target.value)">
 @label.Label(label.Props{For: "assignment-agent"}) { Connected agent }
 @selectField("assignment-agent", "", "target_agent_id", "", true, len(choices) == 0, agentOptions(choices), nil)
 <p class="meta" role="status" aria-live="polite">{ agentChoiceStatus(choices, choicesErr) }</p>
 @button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{
 "data-indicator:_agents-loading": true, "data-attr:disabled": "$_agentsLoading || $_assignPending",
 "data-on:click": "@get('/dialogs/assign/agents', {filterSignals: {include: /^$/}})",
 }}) { Refresh agents }
 </div>
}
