package orchestrator

import (
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
)

templ settingsContent(d pageData) {
	<div id="settings-content" class="view settings-view">
		<div class="view-head">
			<div>
				<h1>Settings</h1>
				<p class="meta">Connect agents, review provider access and rotate credentials.</p>
			</div>
		</div>
		@card.Card(card.Props{Class: "panel", ID: "runtime-settings"}) {
			@card.Header() { @card.Title() { Orchestrator settings } @card.Description() { Dashboard overrides take precedence over explicit CLI flags and environment defaults. Listener changes require restart. } }
			@card.Content() {
				<form method="post" action="/settings/orchestrator"><input type="hidden" name="_csrf" value={ d.csrf }/>@viewFields(d.v)
					<h3>Runtime</h3>
					<div class="field-grid">
						@textField("runtime-listen", "listen", "HTTP listen address", dashboardValue(d, "listen", "JAWA_ORCHESTRATOR_LISTEN", "127.0.0.1:8080"), false)
						@textField("runtime-nats-listen", "nats-listen", "Embedded NATS listen address", dashboardValue(d, "nats-listen", "JAWA_ORCHESTRATOR_NATS_LISTEN", "127.0.0.1:4222"), false)
						@textField("runtime-debug", "debug", "Debug logs (true/false)", dashboardValue(d, "debug", "JAWA_ORCHESTRATOR_DEBUG", "false"), false)
					</div>
					<h3>Git providers</h3>
					<p class="muted small">Read-only tokens support pull-request, CI and review verification. Secret values are never displayed; entering a non-empty value replaces the token.</p>
					<div class="field-grid">
						for _, p := range providerConfigs(d.dashboard) {
							<div class="field">
								<label for={ "runtime-" + strings.ToLower(p.Name) + "-token" }>{ p.Name } read-only token (write-only)</label>
								@input.Input(input.Props{ID: "runtime-" + strings.ToLower(p.Name) + "-token", Name: strings.ToLower(p.Name) + "-token", Type: "password", Attributes: templ.Attributes{"autocomplete": "new-password"}})
								<label><input type="checkbox" name={ strings.ToLower(p.Name) + "-token-clear" } value="true"/> Clear saved { p.Name } token override</label>
								<span class="muted small mono">{ p.Detail }</span>
								if p.Configured {
									@badge.Badge(badge.Props{Class: "badge-ok"}) { Configured }
								} else {
									@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { Not configured }
								}
							</div>
							if p.Name == "GitHub" {
								@textField("runtime-allow-no-ci", "allow-no-ci", "Allow missing CI (true/false)", dashboardValue(d, "allow-no-ci", "JAWA_ALLOW_NO_CI", "false"), false)
							}
						}
					</div>
					<p class="muted small">Cards reach Done only after the pull request, its CI and review feedback pass verification. Done means ready for human review and merge; Jawa never merges for you.</p>
					<div class="form-actions">@submit("Save")</div>
				</form>
				<details class="settings-reset"><summary>Reset settings</summary>
					<p class="muted small">Reset removes all dashboard overrides and restores values from CLI flags, environment defaults, or built-in defaults. This does not change standalone agent or serve modes.</p>
					<form method="post" action="/settings/orchestrator/reset"><input type="hidden" name="_csrf" value={ d.csrf }/>@viewFields(d.v)
						<button class="btn btn-secondary" type="submit">Reset all dashboard overrides</button>
					</form>
				</details>
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "connection"}) {
			@card.Header() {
				@card.Title() {
					Agent connection
				}
				@card.Description() {
					Agents connect to the embedded NATS server with these credentials. Rotating them disconnects agents using the old password. Remote access needs TLS in front of NATS.
				}
			}
			@card.Content() {
				<div class="field">
					@label.Label(label.Props{For: "nats-url"}) {
						Server address
					}
					<div class="input-row">
						@input.Input(input.Props{ID: "nats-url", Value: natsDisplayURL(d.nats.URL), Attributes: templ.Attributes{"readonly": true}})
						<jawa-copy text={ natsDisplayURL(d.nats.URL) }>
							<button type="button" class="btn" aria-label="Copy server address">
								@icon("copy")
								<span class="copy-label">Copy</span>
							</button>
						</jawa-copy>
					</div>
				</div>
				<form method="post" action="/settings/nats" data-reset-on-success data-on:submit__prevent="@post('/settings/nats', {contentType:'form'})">
					<input type="hidden" name="_csrf" value={ d.csrf }/>
					@viewFields(d.v)
					<input type="hidden" name="url" value={ d.nats.URL }/>
					<div class="field-grid">
						@textField("nats-user", "username", "Username", d.nats.Username, true)
						<div class="field">
							@label.Label(label.Props{For: "nats-password"}) {
								New password
							}
							@input.Input(input.Props{ID: "nats-password", Name: "password", Type: "password", Required: true, Placeholder: "At least 12 characters", Attributes: templ.Attributes{"minlength": "12", "autocomplete": "new-password"}})
						</div>
					</div>
					<div class="form-actions">
						@submit("Rotate credentials")
					</div>
				</form>
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "connect-agent"}) {
			@card.Header() {
				@card.Title() {
					Connect an agent
				}
				@card.Description() {
					Run this on any machine that can reach the server. Use the agent password you set above.
				}
			}
			@card.Content() {
				@connectBlock(d)
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "providers"}) {
			@card.Header() {
				@card.Title() {
					Git providers
				}
				@card.Description() {
					The orchestrator verifies pull requests, CI and review feedback using read-only tokens from its own environment. Values are never shown.
				}
			}
			@card.Content() {
				<ul class="rows">
					for _, p := range providerConfigs(d.dashboard) {
						<li class="row">
							@icon("key")
							<div class="row-text">
								<strong>{ p.Name }</strong>
								<span class="muted mono">{ p.Detail }</span>
							</div>
							if p.Configured {
								@badge.Badge(badge.Props{Class: "badge-ok"}) {
									Configured
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
									Not configured
								}
							}
						</li>
					}
				</ul>
				@separator.Separator()
				<p class="muted small">Cards reach Done only after the pull request, its CI and review feedback pass verification. Done means ready for human review and merge; Jawa never merges for you.</p>
			}
		}
	</div>
}
