package orchestrator

import (
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	switchcomp "github.com/axadrn/shadcn-templ/v2/components/switch"
)

templ settingsContent(d pageData) {
	<div id="settings-content" class="view settings-view">
		<div class="view-head">
			<div>
				<h1>Settings</h1>
				<p class="meta">Connect agents, manage Git provider access and tune the orchestrator.</p>
			</div>
		</div>
		if !d.natsConfigured {
			@alert.Alert(alert.Props{Class: "notice", }) {
				Complete NATS authentication setup: choose an agent password below. The default username is worker. Projects, cards and work remain blocked until credentials are saved.
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "connection"}) {
			@card.Header() {
				@card.Title() {
					Agents
				}
				@card.Description() {
					Agents join through the embedded NATS server. Rotating the password disconnects agents still using the old one. Put TLS in front of NATS for remote access.
				}
			}
			@card.Content() {
				<form method="post" action="/settings/nats" data-reset-on-success data-on:submit__prevent="@post('/settings/nats', {contentType:'form'})">
					<input type="hidden" name="_csrf" value={ d.csrf }/>
					@viewFields(d.v)
					<input type="hidden" name="url" value={ d.nats.URL }/>
					<div class="field-grid">
						@textField("nats-user", "username", "Username", d.nats.Username, true)
						<div class="field">
							@label.Label(label.Props{For: "nats-password"}) {
								New password
							}
							@input.Input(input.Props{ID: "nats-password", Name: "password", Type: "password", Required: true, Placeholder: "At least 12 characters", Attributes: templ.Attributes{"minlength": "12", "autocomplete": "new-password"}})
						</div>
					</div>
					<div class="form-actions">
						if d.natsConfigured {
							@submit("Rotate credentials")
						} else {
							@submit("Save credentials and continue")
						}
					</div>
				</form>
				<div class="settings-sub" id="connect-agent">
					<div class="settings-sub-head">
						<h3>Connect an agent</h3>
						<p class="muted small">Run on any machine that can reach { natsDisplayURL(d.nats.URL) }, using the password above.</p>
					</div>
					@connectBlock(d)
				</div>
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "providers"}) {
			@card.Header() {
				@card.Title() {
					Git providers
				}
				@card.Description() {
					Read-only tokens support listing and verification. New card defaults Create issue on; creation needs repository Issues read/write (GitHub) or issue-write (Forgejo). Turn creation off to use read-only tokens. A card reaches Done only after that passes; Jawa never merges for you.
				}
			}
			@card.Content() {
				<form method="post" action="/settings/orchestrator">
					<input type="hidden" name="_csrf" value={ d.csrf }/>
					@viewFields(d.v)
					<ul class="rows provider-rows">
						for _, p := range providerConfigs(d.dashboard, d.defaults) {
							@providerRow(p)
						}
					</ul>
					@switchField("runtime-allow-no-ci", "allow-no-ci", "Allow missing CI", "Accept GitHub pull requests that report no CI checks. Failing checks still block.", dashboardValue(d, "allow-no-ci", "JAWA_ALLOW_NO_CI", "false") == "true")
					<div class="form-actions">
						@submit("Save")
					</div>
				</form>
			}
		}
		@card.Card(card.Props{Class: "panel", ID: "runtime-settings"}) {
			@card.Header() {
				@card.Title() {
					Server
				}
				@card.Description() {
					Values saved here override CLI flags and environment variables. Address changes apply after a restart.
				}
			}
			@card.Content() {
				<form method="post" action="/settings/orchestrator">
					<input type="hidden" name="_csrf" value={ d.csrf }/>
					@viewFields(d.v)
					<div class="field-grid">
						@monoField("runtime-listen", "listen", "Dashboard address", dashboardValue(d, "listen", "JAWA_ORCHESTRATOR_LISTEN", "127.0.0.1:8080"))
						@monoField("runtime-nats-listen", "nats-listen", "NATS address", dashboardValue(d, "nats-listen", "JAWA_ORCHESTRATOR_NATS_LISTEN", "127.0.0.1:4222"))
					</div>
					@switchField("runtime-auto-resume", "auto-resume-failed-runs", "Auto-resume failed runs", "Planning, build and Fix runtime failures: up to five automatic resumes. Applies immediately.", dashboardValue(d, "auto-resume-failed-runs", "", "true") == "true")
					@switchField("runtime-debug", "debug", "Debug logging", "Log polling and ignored deliveries. Applies immediately.", dashboardValue(d, "debug", "JAWA_ORCHESTRATOR_DEBUG", "false") == "true")
					<div class="form-actions">
						@submit("Save")
					</div>
				</form>
			}
		}
		<div class="settings-reset">
			<div>
				<strong>Reset dashboard overrides</strong>
				<p class="muted small">Restores every value above, including saved tokens, to CLI flags, environment variables or built-in defaults.</p>
			</div>
			<form method="post" action="/settings/orchestrator/reset">
				<input type="hidden" name="_csrf" value={ d.csrf }/>
				@viewFields(d.v)
				@button.Button(button.Props{Class: "btn btn-secondary", Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
					Reset overrides
				}
			</form>
		</div>
	</div>
}

templ providerRow(p providerConfig) {
	<li class="row provider-row">
		<div class="provider-head">
			@icon("key")
			<div class="row-text">
				<strong>{ p.Name }</strong>
				<span class="muted mono">{ p.Detail }</span>
			</div>
			if p.Configured {
				@badge.Badge(badge.Props{Class: "badge-ok"}) {
					Configured
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					Not configured
				}
			}
		</div>
		<div class="provider-edit">
			@label.Label(label.Props{Class: "sr-only", For: "runtime-" + strings.ToLower(p.Name) + "-token"}) {
				{ p.Name } provider token
			}
			@input.Input(input.Props{ID: "runtime-" + strings.ToLower(p.Name) + "-token", Name: strings.ToLower(p.Name) + "-token", Type: "password", Placeholder: "Paste a new token to replace", Attributes: templ.Attributes{"autocomplete": "new-password"}})
			@label.Label(label.Props{Class: "check"}) {
				@checkbox.Checkbox(checkbox.Props{ID: strings.ToLower(p.Name) + "-token-clear", Name: strings.ToLower(p.Name) + "-token-clear", Value: "true"})
				<span>Clear saved { p.Name } token override</span>
			}
		</div>
	</li>
}

// switchField posts "true" when on. The hidden input that follows supplies
// "false" when off; the server reads the first value, so order matters.
templ switchField(id, name, title, hint string, on bool) {
	<div class="switch-field">
		@label.Label(label.Props{For: id}) {
			<span class="switch-title">{ title }</span>
			<span class="muted small">{ hint }</span>
		}
		@switchcomp.Switch(switchcomp.Props{ID: id, Name: name, Value: "true", DefaultChecked: on})
		<input type="hidden" name={ name } value="false"/>
	</div>
}

templ monoField(id, name, title, value string) {
	<div class="field">
		@label.Label(label.Props{For: id}) {
			{ title }
		}
		@input.Input(input.Props{ID: id, Name: name, Value: value, Class: "mono-input", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off"}})
	</div>
}
