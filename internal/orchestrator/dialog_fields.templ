package orchestrator

import (
 "strconv"
 "github.com/axadrn/shadcn-templ/v2/components/button"
 "github.com/axadrn/shadcn-templ/v2/components/label"
 "github.com/axadrn/shadcn-templ/v2/components/checkbox"
)

templ cardIssueField(issues []projectIssue, status, recoveryState string) {
 <div id="card-issue-field" class="field" data-signals="{cardIssue: '', cardRecoveryAction: '', _issueNote: ''}" data-computed:_picked-issue="$_issues.find(i => i.url === $cardIssue)">
 @label.Label(label.Props{For: "card-issue"}) { Open issue (optional) }
 <div class="issue-autofill-row">
 <div data-on:change="evt.target.name === 'issue_url' && ($cardIssue = evt.target.value, $_issueNote = '')">
 @selectField("card-issue", "", "issue_url", "", false, len(issues) == 0, issueOptions(issues), templ.Attributes{"aria-describedby": "card-issue-status"})
 </div>
 <fieldset class="contents" data-show="!$cardIssue" data-attr:disabled="$cardIssue !== '' || $cardRecoveryAction !== ''">
 @label.Label(label.Props{ID: "card-create-issue-label", For: "card-create-issue"}) {
 @checkbox.Checkbox(checkbox.Props{ID: "card-create-issue", Name: "create_issue", Value: "yes", DefaultChecked: !issueRecoveryBlocked(recoveryState), Disabled: issueRecoveryBlocked(recoveryState), Attributes: templ.Attributes{"aria-labelledby": "card-create-issue-label", "aria-describedby": "card-create-issue-help"}})
 Create issue
 }
 </fieldset>
 @button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{
 "data-show": "$cardIssue", "aria-describedby": "card-issue-autofill-help",
 "data-on:click": "$_pickedIssue && ($cardTitle = $_pickedIssue.title, $cardDescription = $_pickedIssue.body, $_issueNote = 'Title and description copied. You can edit both fields.')",
 }}) { Autofill }
 </div>
 <p id="card-create-issue-help" class="muted" data-show="!$cardIssue">Creating the card will also create and link an issue in this project's repository.</p>
 <p id="card-issue-autofill-help" class="muted" data-show="$cardIssue">Autofill replaces the title and description. You can edit them afterward.</p>
 <p id="card-issue-status" class="muted" role="status" aria-live="polite" data-text={ "$_issueNote || " + strconv.Quote(status) }>{ status }</p>
 @button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{
 "data-indicator:_issues-loading": true, "data-attr:disabled": "$_issuesLoading || $_cardPending",
 "data-on:click": "@get('/dialogs/card/issues?project_id=' + encodeURIComponent($cardProject), {filterSignals: {include: /^$/}})",
 }}) { Refresh issues }
 </div>
}
