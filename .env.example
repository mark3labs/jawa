# Copy to .env and fill in credentials. Never commit .env.
# Docker: docker run --env-file .env ... ghcr.io/mark3labs/jawa:latest
# Use a broker address reachable from the container; localhost is the container.
NATS_URL=tls://your-nats-server:4222
NATS_USERNAME=worker
NATS_PASSWORD=

# Model provider and GitHub credentials
OPENCODE_API_KEY=
GITHUB_TOKEN=
JAWA_MODEL=opencode/glm-5.3-flash

# Unique, stable ID per worker (letters, digits, hyphens); use a separate volume.
JAWA_NATS_WORKER_ID=jawa-1
JAWA_NATS_ROOT_SUBJECT=bonnie
JAWA_NATS_CREATE_STREAM=true
# Optional shared task consumer override:
# JAWA_NATS_CONSUMER=jawa-workers

# Alternative broker auth: use only ONE method (user/password, token, or NKey).
# The sample submit CLI currently supports user/password authentication.
# NATS_TOKEN=
# NATS_NKEY_SEED=

# Docker defaults. Publish HTTP only on host loopback: -p 127.0.0.1:8080:8080
# JAWA_HTTP_ADDR=0.0.0.0:8080
# JAWA_SANDBOX_ROOT=/w

# Local mode lets coding commands access the container's environment, including
# these credentials. Use least-privilege secrets and trusted tasks only.
